# Copy to admin-panel/.env.local (git-ignored).
# Only public settings belong here: every VITE_ variable is built into the JavaScript that browsers download.
# Never put backend secrets (database URLs, TOKEN_PEPPER, SMTP passwords) in this file; they live in backend/backend.env.

# ClinicOS backend base URL. The backend must list this app's origin in CORS_ORIGINS.
VITE_API_URL=http://localhost:4000
