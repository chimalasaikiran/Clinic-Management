  @@index([orderId, createdAt])
  @@map("order_events")
}

enum ReferralDirection {
  outgoing
  incoming

  @@map("referral_direction")
}

enum ReferralStatus {
  pending_acceptance
  awaiting_review
  info_requested
  accepted
  scheduled
  completed
  declined
  cancelled

  @@map("referral_status")
}

model Referral {
  id                   String            @id @default(uuid(7)) @db.Uuid
  orgId                String            @map("org_id") @db.Uuid
  reference            String            @db.VarChar(20)
  patientId            String            @map("patient_id") @db.Uuid
  encounterId          String?           @map("encounter_id") @db.Uuid
  direction            ReferralDirection
  status               ReferralStatus
  priority             String            @db.VarChar(60)
  // Hours the receiving side has to respond, from the priority.
  windowHours          Int               @map("window_hours") @db.SmallInt
  model                String            @db.VarChar(80)
  specialty            String            @db.VarChar(120)
  indication           String            @db.VarChar(500)
  narrative            String            @db.VarChar(4000)
  questions            String[]          @db.VarChar(500)
  attachedRecords      String[]          @map("attached_records") @db.VarChar(240)
  // Outgoing: where it goes. Incoming: where it came from. An internal target is one of the clinic's therapists.
  targetPractitionerId String?           @map("target_practitioner_id") @db.Uuid
  facility             String            @db.VarChar(240)
  facilityNote         String            @default("") @map("facility_note") @db.VarChar(240)
  clinician            String            @db.VarChar(160)
  clinicianNote        String            @default("") @map("clinician_note") @db.VarChar(240)
  outcome              String            @default("") @db.VarChar(240)
  createdById          String            @map("created_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  version              Int               @default(1)

  organisation       Organisation    @relation(fields: [orgId], references: [id])
  patient            Patient         @relation(fields: [patientId], references: [id])
  encounter          Encounter?      @relation(fields: [encounterId], references: [id])
  targetPractitioner Practitioner?   @relation(fields: [targetPractitionerId], references: [id])
  createdBy          User            @relation("ReferralCreatedBy", fields: [createdById], references: [id])
  events             ReferralEvent[]

  @@unique([orgId, reference])
  @@index([orgId, patientId, createdAt])
  @@map("referrals")
}

model ReferralEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  referralId String   @map("referral_id") @db.Uuid
  title      String   @db.VarChar(240)
  text       String   @default("") @db.VarChar(2000)
  actorId    String   @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  actor    User     @relation("ReferralEventActor", fields: [actorId], references: [id])

  @@index([referralId, createdAt])
  @@map("referral_events")
}

enum CarePlanStatus {
  on_track
  at_risk
  achieved
  closed

  @@map("care_plan_status")
}

model CarePlan {
  id                 String         @id @default(uuid(7)) @db.Uuid
  orgId              String         @map("org_id") @db.Uuid
  reference          String         @db.VarChar(20)
  patientId          String         @map("patient_id") @db.Uuid
  leadPractitionerId String         @map("lead_practitioner_id") @db.Uuid
  title              String         @db.VarChar(200)
  category           String         @db.VarChar(120)
  rationale          String         @db.VarChar(4000)
  startDate          DateTime       @map("start_date") @db.Date
  nextReview         DateTime       @map("next_review") @db.Date
  targetDate         DateTime       @map("target_date") @db.Date
  // Linked problems as [{ icd, name }].
  diagnoses          Json
  education          String[]       @db.VarChar(500)
  whatsapp           Boolean        @default(false)
  status             CarePlanStatus @default(on_track)
  compliance         Int            @default(0) @db.SmallInt
  createdById        String         @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int            @default(1)

  organisation     Organisation           @relation(fields: [orgId], references: [id])
  patient          Patient                @relation(fields: [patientId], references: [id])
  leadPractitioner Practitioner           @relation(fields: [leadPractitionerId], references: [id])
  createdBy        User                   @relation("CarePlanCreatedBy", fields: [createdById], references: [id])
  goals            CarePlanGoal[]
  interventions    CarePlanIntervention[]
  reviews          CarePlanReview[]

  @@unique([orgId, reference])
  @@index([orgId, patientId])
  @@index([orgId, status, nextReview])
  @@map("care_plans")
}

model CarePlanGoal {
  id          String  @id @default(uuid(7)) @db.Uuid
  carePlanId  String  @map("care_plan_id") @db.Uuid
  position    Int     @db.SmallInt
  title       String  @db.VarChar(200)
  target      String  @db.VarChar(200)
  protocol    String  @default("") @db.VarChar(500)
  cadence     String  @db.VarChar(80)
  status      String  @default("Pending Baseline") @db.VarChar(40)
  observation String? @db.VarChar(1000)

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@unique([carePlanId, position])
  @@map("care_plan_goals")
}

model CarePlanIntervention {
  id         String @id @default(uuid(7)) @db.Uuid
  carePlanId String @map("care_plan_id") @db.Uuid
  position   Int    @db.SmallInt
  type       String @db.VarChar(40)
  title      String @db.VarChar(200)
  due        String @default("") @db.VarChar(120)
  state      String @default("Staged") @db.VarChar(40)

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@unique([carePlanId, position])
  @@map("care_plan_interventions")
}

model CarePlanReview {
  id          String   @id @default(uuid(7)) @db.Uuid
  carePlanId  String   @map("care_plan_id") @db.Uuid
  kind        String   @db.VarChar(20)
  observation String   @db.VarChar(2000)
  summary     String   @db.VarChar(2000)
  barriers    String[] @db.VarChar(120)
  authorId    String   @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  author   User     @relation("CarePlanReviewAuthor", fields: [authorId], references: [id])

  @@index([carePlanId, createdAt])
  @@map("care_plan_reviews")
}

// A patient-safety incident report. An anonymous report stores no reporter at all.
model Incident {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  reference     String   @db.VarChar(20)
  patientId     String?  @map("patient_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  category      String   @db.VarChar(40)
  severity      Int      @db.SmallInt
  occurredOn    DateTime @map("occurred_on") @db.Date
  occurredTime  String   @map("occurred_time") @db.VarChar(5)
  zone          String   @db.VarChar(160)
  headline      String   @db.VarChar(240)
  chronology    String   @db.VarChar(4000)
  factors       String[] @db.VarChar(120)
  actions       String   @default("") @db.VarChar(2000)
  witnesses     String[] @db.VarChar(160)
  notifyQuality Boolean  @default(true) @map("notify_quality")
  logRegister   Boolean  @default(true) @map("log_register")
  reporterId    String?  @map("reporter_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  reporter     User?        @relation("IncidentReporter", fields: [reporterId], references: [id])

  @@unique([orgId, reference])
  @@index([orgId, createdAt])
  @@map("incidents")
}

// ─── Billing & finance ───────────────────────────────────────────────────────

enum BillingServiceStatus {
  active
  inactive

  @@map("billing_service_status")
}

enum TaxTreatment {
  exempt
  no_tax
  taxable
  not_configured

  @@map("tax_treatment")
}

enum ChargeStatus {
  draft
  unbilled
  invoiced

  @@map("charge_status")
}

enum RefundStatus {
  pending
  approved
  processed
  failed
  rejected

  @@map("refund_status")
}

enum StatementLineState {
  matched
  candidate
  exception
  resolved

  @@map("statement_line_state")
}

enum ReconExceptionStatus {
  open
  in_review
  resolved

  @@map("recon_exception_status")
}

// The organisation's service catalogue: what can be charged and at what default price and tax.
model BillingService {
  id           String               @id @default(uuid(7)) @db.Uuid
  orgId        String               @map("org_id") @db.Uuid
  code         String               @db.VarChar(40)
  name         String               @db.VarChar(200)
  category     String               @db.VarChar(80)
  department   String?              @db.VarChar(120)
  description  String               @default("") @db.VarChar(2000)
  unit         String?              @db.VarChar(40)
  status       BillingServiceStatus @default(inactive)
  price        Decimal              @db.Decimal(12, 2)
  taxTreatment TaxTreatment         @default(not_configured) @map("tax_treatment")
  taxConfig    String?              @map("tax_config") @db.VarChar(80)
  // GST percentage that follows from the tax configuration; 0 unless taxable.
  gstRate      Decimal              @default(0) @map("gst_rate") @db.Decimal(5, 2)
  createdById  String               @map("created_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int                  @default(1)

  organisation Organisation          @relation(fields: [orgId], references: [id])
  createdBy    User                  @relation("BillingServiceCreatedBy", fields: [createdById], references: [id])
  prices       BillingServicePrice[]
  charges      Charge[]
  invoiceLines InvoiceLine[]

  @@unique([orgId, code])
  @@map("billing_services")
}

// Where a service is offered. A null price means the branch charges the service default.
model BillingServicePrice {
  serviceId String   @map("service_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  price     Decimal? @db.Decimal(12, 2)

  service BillingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id])

  @@id([serviceId, branchId])
  @@map("billing_service_prices")
}

// Prospective billing defaults for the organisation. Saving never changes existing records.
model BillingSettings {
  orgId            String   @id @map("org_id") @db.Uuid
  billingModel     String   @default("Pay-as-you-go") @map("billing_model") @db.VarChar(30)
  cashEnabled      Boolean  @default(true) @map("cash_enabled")
  bankEnabled      Boolean  @default(true) @map("bank_enabled")
  upiEnabled       Boolean  @default(true) @map("upi_enabled")
  advancePolicy    String   @default("") @map("advance_policy") @db.VarChar(60)
  partialPolicy    String   @default("") @map("partial_policy") @db.VarChar(60)
  allocationPolicy String   @default("") @map("allocation_policy") @db.VarChar(60)
  invoiceDocument  String   @default("") @map("invoice_document") @db.VarChar(60)
  receiptDocument  String   @default("") @map("receipt_document") @db.VarChar(60)
  updatedById      String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version          Int      @default(1)

  organisation Organisation @relation(fields: [orgId], references: [id])
  updatedBy    User?        @relation("BillingSettingsUpdatedBy", fields: [updatedById], references: [id])

  @@map("billing_settings")
}

// The activity history of every finance record (services, settings, charges, refunds, exceptions...).
model FinanceEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(30)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(60)
  note       String   @default("") @db.VarChar(1000)
  // Null for steps taken by the system, such as statement matching.
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  actor        User?        @relation("FinanceEventActor", fields: [actorId], references: [id])

  @@index([orgId, entityType, entityId, createdAt])
  @@map("finance_events")
}

// An amount owed for one service. Draft charges can be edited; confirmed ones are fixed until invoiced.
model Charge {
  id          String       @id @default(uuid(7)) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  reference   String       @db.VarChar(20)
  patientId   String       @map("patient_id") @db.Uuid
  branchId    String       @map("branch_id") @db.Uuid
  encounterId String?      @map("encounter_id") @db.Uuid
  serviceId   String       @map("service_id") @db.Uuid
  payer       String       @db.VarChar(60)
  model       String       @db.VarChar(30)
  chargeDate  DateTime     @map("charge_date") @db.Date
  status      ChargeStatus @default(draft)
  invoiceId   String?      @map("invoice_id") @db.Uuid
  note        String       @default("") @db.VarChar(1000)
  // The service as it was priced for this charge.
  code        String       @db.VarChar(40)
  name        String       @db.VarChar(200)
  category    String       @db.VarChar(80)
  department  String?      @db.VarChar(120)
  quantity    Int
  unitPrice   Decimal      @map("unit_price") @db.Decimal(12, 2)
  discountPct Decimal      @default(0) @map("discount_pct") @db.Decimal(5, 2)
  gstPct      Decimal      @default(0) @map("gst_pct") @db.Decimal(5, 2)
  total       Decimal      @db.Decimal(12, 2)
  createdById String       @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int          @default(1)

  organisation Organisation   @relation(fields: [orgId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id])
  branch       Branch         @relation(fields: [branchId], references: [id])
  encounter    Encounter?     @relation(fields: [encounterId], references: [id])
  service      BillingService @relation(fields: [serviceId], references: [id])
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id])
  createdBy    User           @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  invoiceLines InvoiceLine[]

  @@unique([orgId, reference])
  @@index([orgId, patientId, status])
  @@index([orgId, chargeDate])
  @@map("charges")
}

// An issued invoice. Lines and totals are fixed at issue; the balance follows the allocations made to it.
model Invoice {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  reference    String   @db.VarChar(20)
  patientId    String   @map("patient_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  encounterId  String?  @map("encounter_id") @db.Uuid
  payer        String   @db.VarChar(60)
  model        String   @db.VarChar(30)
  invoiceDate  DateTime @map("invoice_date") @db.Date
  dueDate      DateTime @map("due_date") @db.Date
  title        String   @db.VarChar(240)
  publicNote   String   @default("") @map("public_note") @db.VarChar(1000)
  internalNote String   @default("") @map("internal_note") @db.VarChar(1000)
  gross        Decimal  @db.Decimal(12, 2)
  discount     Decimal  @db.Decimal(12, 2)
  tax          Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  createdById  String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  patient      Patient             @relation(fields: [patientId], references: [id])
  branch       Branch              @relation(fields: [branchId], references: [id])
  encounter    Encounter?          @relation(fields: [encounterId], references: [id])
  createdBy    User                @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  lines        InvoiceLine[]
  charges      Charge[]
  allocations  PaymentAllocation[]

  @@unique([orgId, reference])
  @@index([orgId, patientId])
  @@index([orgId, invoiceDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  position    Int     @db.SmallInt
  // A line comes from a confirmed charge, or straight from the catalogue.
  chargeId    String? @unique @map("charge_id") @db.Uuid
  serviceId   String? @map("service_id") @db.Uuid
  code        String  @db.VarChar(40)
  name        String  @db.VarChar(200)
  note        String  @default("") @db.VarChar(200)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  discountPct Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  gstPct      Decimal @default(0) @map("gst_pct") @db.Decimal(5, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  charge  Charge?         @relation(fields: [chargeId], references: [id])
  service BillingService? @relation(fields: [serviceId], references: [id])

  @@unique([invoiceId, position])
  @@map("invoice_lines")
}

// Money received. Never edited: allocations and refunds are separate records against it.
model Payment {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  reference     String   @db.VarChar(20)
  // Every payment gets a receipt number when it is recorded.
  receiptNumber String   @map("receipt_number") @db.VarChar(20)
  patientId     String   @map("patient_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  channel       String   @db.VarChar(40)
  payer         String   @db.VarChar(60)
  purpose       String   @db.VarChar(20)
  txnReference  String?  @map("txn_reference") @db.VarChar(120)
  narration     String   @default("") @db.VarChar(500)
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  recordedById  String   @map("recorded_by") @db.Uuid

  organisation   Organisation        @relation(fields: [orgId], references: [id])
  patient        Patient             @relation(fields: [patientId], references: [id])
  branch         Branch              @relation(fields: [branchId], references: [id])
  recordedBy     User                @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  allocations    PaymentAllocation[]
  refunds        Refund[]
  statementLines StatementLine[]

  @@unique([orgId, reference])
  @@unique([orgId, receiptNumber])
  @@index([orgId, patientId])
  @@index([orgId, receivedAt])
  @@index([orgId, txnReference])
  @@map("payments")
}

// Part of a payment applied to an invoice. A negative amount releases an earlier allocation (for a refund).
model PaymentAllocation {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  reference   String   @db.VarChar(20)
  paymentId   String   @map("payment_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  refundId    String?  @map("refund_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  payment      Payment      @relation(fields: [paymentId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  refund       Refund?      @relation(fields: [refundId], references: [id])
  createdBy    User         @relation("AllocationCreatedBy", fields: [createdById], references: [id])

  @@unique([orgId, reference])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// Money returned against a payment: requested, approved, then processed (or failed / rejected).
model Refund {
  id                  String       @id @default(uuid(7)) @db.Uuid
  orgId               String       @map("org_id") @db.Uuid
  reference           String       @db.VarChar(20)
  paymentId           String       @map("payment_id") @db.Uuid
  patientId           String       @map("patient_id") @db.Uuid
  amount              Decimal      @db.Decimal(12, 2)
  reason              String       @db.VarChar(120)
  method              String       @db.VarChar(80)
  internalReference   String       @map("internal_reference") @db.VarChar(80)
  notes               String       @default("") @db.VarChar(1000)
  // When true the refund may take back money already applied to invoices, reopening their balances.
  releasesAllocations Boolean      @default(false) @map("releases_allocations")
  status              RefundStatus @default(pending)
  outcomeReference    String?      @map("outcome_reference") @db.VarChar(120)
  outcomeNote         String?      @map("outcome_note") @db.VarChar(1000)
  requestedById       String       @map("requested_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt           DateTime?    @map("decided_at") @db.Timestamptz(6)
  completedAt         DateTime?    @map("completed_at") @db.Timestamptz(6)
  version             Int          @default(1)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  payment      Payment             @relation(fields: [paymentId], references: [id])
  patient      Patient             @relation(fields: [patientId], references: [id])
  requestedBy  User                @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  releases     PaymentAllocation[]

  @@unique([orgId, reference])
  @@index([paymentId])
  @@index([orgId, status])
  @@map("refunds")
}

// A bank or gateway statement uploaded for reconciliation.
model StatementImport {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  reference    String   @db.VarChar(20)
  source       String   @db.VarChar(60)
  fileName     String   @map("file_name") @db.VarChar(200)
  lineCount    Int      @map("line_count")
  importedById String   @map("imported_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation    @relation(fields: [orgId], references: [id])
  importedBy   User            @relation("StatementImportedBy", fields: [importedById], references: [id])
  lines        StatementLine[]

  @@unique([orgId, reference])
  @@map("statement_imports")
}

// One transaction from an imported statement, kept as it was received, and the payment it was matched to.
model StatementLine {
  id              String             @id @default(uuid(7)) @db.Uuid
  orgId           String             @map("org_id") @db.Uuid
  importId        String             @map("import_id") @db.Uuid
  source          String             @db.VarChar(60)
  sourceReference String             @map("source_reference") @db.VarChar(120)
  txnDate         DateTime           @map("txn_date") @db.Date
  txnTime         String?            @map("txn_time") @db.VarChar(5)
  amount          Decimal            @db.Decimal(12, 2)
  narration       String             @default("") @db.VarChar(300)
  paymentId       String?            @map("payment_id") @db.Uuid
  state           StatementLineState

  organisation Organisation    @relation(fields: [orgId], references: [id])
  import       StatementImport @relation(fields: [importId], references: [id])
  payment      Payment?        @relation(fields: [paymentId], references: [id])
  exception    ReconException?

  @@unique([orgId, source, sourceReference])
  @@index([orgId, txnDate])
  @@index([paymentId])
  @@map("statement_lines")
}

// A statement line that could not be matched cleanly, worked through to a documented resolution.
model ReconException {
  id             String               @id @default(uuid(7)) @db.Uuid
  orgId          String               @map("org_id") @db.Uuid
  reference      String               @db.VarChar(20)
  lineId         String               @unique @map("line_id") @db.Uuid
  kind           String               @db.VarChar(60)
  reason         String               @db.VarChar(1000)
  status         ReconExceptionStatus @default(open)
  ownerId        String?              @map("owner_id") @db.Uuid
  evidence       String?              @db.VarChar(500)
  resolutionType String?              @map("resolution_type") @db.VarChar(80)
  resolutionNote String?              @map("resolution_note") @db.VarChar(1000)
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  version        Int                  @default(1)

  organisation Organisation  @relation(fields: [orgId], references: [id])
  line         StatementLine @relation(fields: [lineId], references: [id])
  owner        User?         @relation("ReconExceptionOwner", fields: [ownerId], references: [id])

  @@unique([orgId, reference])
  @@index([orgId, status])
  @@map("reconciliation_exceptions")
}

// ─── Inventory & pharmacy ────────────────────────────────────────────────────

enum StockLocationKind {
  store
  pharmacy

  @@map("stock_location_kind")
}

enum StockRequestStatus {
  draft
  submitted
  approved
  partially_approved
  dispatched
  partially_fulfilled
  fulfilled
  rejected
  cancelled

  @@map("stock_request_status")
}

enum TransferStatus {
  draft
  ready
  in_transit
  received
  cancelled

  @@map("transfer_status")
}

enum GoodsReceiptStatus {
  draft
  reconciliation_required
  ready_to_post
  posted

  @@map("goods_receipt_status")
}

enum AdjustmentStatus {
  draft
  posted
  rejected

  @@map("adjustment_status")
}

enum PharmacyCaseStatus {
  draft
  awaiting_review
  resolved
  rejected

  @@map("pharmacy_case_status")
}

// The item master: everything the organisation stocks, with its replenishment levels.
model StockItem {
  id                  String   @id @default(uuid(7)) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  code                String   @db.VarChar(40)
  name                String   @db.VarChar(160)
  category            String   @db.VarChar(60)
  unit                String   @db.VarChar(30)
  unitPlural          String   @map("unit_plural") @db.VarChar(30)
  dosageForm          String?  @map("dosage_form") @db.VarChar(80)
  brand               String?  @db.VarChar(160)
  pack                String?  @db.VarChar(80)
  storage             String?  @db.VarChar(120)
  // Drug schedule (H, H1, X) when the item is a scheduled medicine.
  schedule            String?  @db.VarChar(4)
  // Links the item to the prescribing catalogue, so a prescription line can be dispensed from it.
  medicineCode        String?  @map("medicine_code") @db.VarChar(60)
  strength            String?  @db.VarChar(40)
  unitPrice           Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  safetyLevel         Int      @default(0) @map("safety_level")
  reorderLevel        Int      @default(0) @map("reorder_level")
  targetLevel         Int      @default(0) @map("target_level")
  preferredSupplierId String?  @map("preferred_supplier_id") @db.Uuid
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version             Int      @default(1)

  organisation      Organisation        @relation(fields: [orgId], references: [id])
  preferredSupplier Supplier?           @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  suppliers         StockItemSupplier[]
  batches           StockBatch[]
  movements         StockMovement[]
  requestLines      StockRequestLine[]
  transferLines     StockTransferLine[]
  orderLines        PurchaseOrderLine[]
  receiptLines      GoodsReceiptLine[]
  adjustments       StockAdjustment[]
  dispenseLines     DispenseLine[]
  cases             PharmacyCase[]

  @@unique([orgId, code])
  @@index([orgId, medicineCode])
  @@map("stock_items")
}

// A store or pharmacy at a branch, where stock is held.
model StockLocation {
  id        String            @id @default(uuid(7)) @db.Uuid
  orgId     String            @map("org_id") @db.Uuid
  branchId  String            @map("branch_id") @db.Uuid
  code      String            @db.VarChar(20)
  name      String            @db.VarChar(120)
  detail    String            @default("") @db.VarChar(160)
  kind      StockLocationKind
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation  Organisation    @relation(fields: [orgId], references: [id])
  branch        Branch          @relation(fields: [branchId], references: [id])
  batches       StockBatch[]
  movements     StockMovement[]
  requests      StockRequest[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  orders        PurchaseOrder[]
  receipts      GoodsReceipt[]
  dispenses     Dispense[]

  @@unique([orgId, code])
  @@map("stock_locations")
}

model Supplier {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  code         String?  @db.VarChar(20)
  name         String   @db.VarChar(160)
  contact      String   @default("") @db.VarChar(120)
  phone        String   @default("") @db.VarChar(30)
  email        String   @default("") @db.VarChar(254)
  categories   String[] @db.VarChar(40)
  address      String   @default("") @db.VarChar(240)
  city         String   @default("") @db.VarChar(80)
  state        String   @default("") @db.VarChar(80)
  postal       String   @default("") @db.VarChar(12)
  country      String   @default("") @db.VarChar(80)
  gstin        String   @default("") @db.VarChar(15)
  registration String   @default("") @db.VarChar(80)
  terms        String   @default("") @db.VarChar(40)
  notes        String   @default("") @db.VarChar(1000)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  version      Int      @default(1)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  items        StockItemSupplier[]
  preferredFor StockItem[]         @relation("PreferredSupplier")
  orders       PurchaseOrder[]
  receipts     GoodsReceipt[]

  @@unique([orgId, name])
  @@map("suppliers")
}

model StockItemSupplier {
  itemId     String @map("item_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid

  item     StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([itemId, supplierId])
  @@map("stock_item_suppliers")
}

// One batch of an item at a location. Available = posted − reserved − quarantine; expired stock is never available.
model StockBatch {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  batchNo    String   @map("batch_no") @db.VarChar(40)
  expiry     DateTime @db.Date
  posted     Int      @default(0)
  reserved   Int      @default(0)
  quarantine Int      @default(0)
  bin        String   @default("") @db.VarChar(40)

  organisation Organisation       @relation(fields: [orgId], references: [id])
  item         StockItem          @relation(fields: [itemId], references: [id])
  location     StockLocation      @relation(fields: [locationId], references: [id])
  reservations StockReservation[]
  movements    StockMovement[]

  @@unique([itemId, locationId, batchNo])
  @@index([orgId, locationId])
  @@map("stock_batches")
}

// The stock ledger: every change to posted or reserved stock, with what was available afterwards.
model StockMovement {
  id             String   @id @default(uuid(7)) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  kind           String   @db.VarChar(40)
  reference      String   @db.VarChar(30)
  batchLabel     String   @map("batch_label") @db.VarChar(200)
  delta          Int
  availableAfter Int      @map("available_after")
  reason         String   @db.VarChar(500)
  actorId        String?  @map("actor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [orgId], references: [id])
  item         StockItem     @relation(fields: [itemId], references: [id])
  location     StockLocation @relation(fields: [locationId], references: [id])
  batch        StockBatch?   @relation(fields: [batchId], references: [id])
  actor        User?         @relation("StockMovementActor", fields: [actorId], references: [id])

  @@index([orgId, createdAt])
  @@index([itemId, locationId])
  @@map("stock_movements")
}

// History of requests, transfers, orders, receipts, adjustments, suppliers, items and cases.
model InventoryEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(30)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(80)
  note       String   @default("") @db.VarChar(1000)
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  actor        User?        @relation("InventoryEventActor", fields: [actorId], references: [id])

  @@index([orgId, entityType, entityId, createdAt])
  @@map("inventory_events")
}

// A pharmacy's request for stock from the central store.
model StockRequest {
  id            String             @id @default(uuid(7)) @db.Uuid
  orgId         String             @map("org_id") @db.Uuid
  reference     String             @db.VarChar(20)
  locationId    String             @map("location_id") @db.Uuid
  priority      String             @db.VarChar(20)
  requiredBy    DateTime?          @map("required_by") @db.Date
  reason        String             @db.VarChar(120)
  notes         String             @default("") @db.VarChar(1000)
  status        StockRequestStatus @default(draft)
  decision      String?            @db.VarChar(40)
  decisionNote  String?            @map("decision_note") @db.VarChar(1000)
  requestedById String             @map("requested_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  version       Int                @default(1)

  organisation Organisation       @relation(fields: [orgId], references: [id])
  location     StockLocation      @relation(fields: [locationId], references: [id])
  requestedBy  User               @relation("StockRequestedBy", fields: [requestedById], references: [id])
  lines        StockRequestLine[]
  transfers    StockTransfer[]

  @@unique([orgId, reference])
  @@map("stock_requests")
}

model StockRequestLine {
  id        String @id @default(uuid(7)) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  requested Int
  approved  Int    @default(0)
  issued    Int    @default(0)
  received  Int    @default(0)

  request      StockRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item         StockItem          @relation(fields: [itemId], references: [id])
  reservations StockReservation[]

  @@unique([requestId, itemId])
  @@map("stock_request_lines")
}

// Stock held at the central store for an approved request line until it is dispatched.
model StockReservation {
  id            String  @id @default(uuid(7)) @db.Uuid
  requestLineId String  @map("request_line_id") @db.Uuid
  batchId       String  @map("batch_id") @db.Uuid
  qty           Int
  // Set once the reservation has been moved onto a transfer.
  transferId    String? @map("transfer_id") @db.Uuid

  requestLine StockRequestLine @relation(fields: [requestLineId], references: [id], onDelete: Cascade)
  batch       StockBatch       @relation(fields: [batchId], references: [id])
  transfer    StockTransfer?   @relation(fields: [transferId], references: [id])

  @@map("stock_reservations")
}

model StockTransfer {
  id             String         @id @default(uuid(7)) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  reference      String         @db.VarChar(20)
  requestId      String?        @map("request_id") @db.Uuid
  fromLocationId String         @map("from_location_id") @db.Uuid
  toLocationId   String         @map("to_location_id") @db.Uuid
  status         TransferStatus @default(draft)
  reason         String         @db.VarChar(120)
  notes          String         @default("") @db.VarChar(1000)
  plannedOn      DateTime?      @map("planned_on") @db.Date
  createdById    String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt   DateTime?      @map("dispatched_at") @db.Timestamptz(6)
  receivedAt     DateTime?      @map("received_at") @db.Timestamptz(6)
  version        Int            @default(1)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  request      StockRequest?       @relation(fields: [requestId], references: [id])
  from         StockLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  to           StockLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy    User                @relation("TransferCreatedBy", fields: [createdById], references: [id])
  lines        StockTransferLine[]
  reservations StockReservation[]

  @@unique([orgId, reference])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         String   @id @default(uuid(7)) @db.Uuid
  transferId String   @map("transfer_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  batchId    String   @map("batch_id") @db.Uuid
  batchNo    String   @map("batch_no") @db.VarChar(40)
  expiry     DateTime @db.Date
  qty        Int
  received   Int      @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     StockItem     @relation(fields: [itemId], references: [id])

  @@map("stock_transfer_lines")
}

model PurchaseOrder {
  id          String    @id @default(uuid(7)) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  reference   String    @db.VarChar(20)
  supplierId  String    @map("supplier_id") @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  orderedOn   DateTime  @map("ordered_on") @db.Date
  expectedOn  DateTime? @map("expected_on") @db.Date
  supplierRef String    @default("") @map("supplier_ref") @db.VarChar(80)
  terms       String    @default("") @db.VarChar(40)
  notes       String    @default("") @db.VarChar(1000)
  draft       Boolean   @default(false)
  closed      Boolean   @default(false)
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  store        StockLocation       @relation(fields: [storeId], references: [id])
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]

  @@unique([orgId, reference])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id      String  @id @default(uuid(7)) @db.Uuid
  orderId String  @map("order_id") @db.Uuid
  itemId  String  @map("item_id") @db.Uuid
  ordered Int
  rate    Decimal @db.Decimal(12, 2)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  StockItem     @relation(fields: [itemId], references: [id])

  @@unique([orderId, itemId])
  @@map("purchase_order_lines")
}

// A delivery counted at a store (GRN). Accepted batches are added to stock when it is posted.
model GoodsReceipt {
  id           String             @id @default(uuid(7)) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  reference    String             @db.VarChar(20)
  orderId      String?            @map("order_id") @db.Uuid
  supplierId   String             @map("supplier_id") @db.Uuid
  storeId      String             @map("store_id") @db.Uuid
  challan      String             @default("") @db.VarChar(80)
  invoice      String             @default("") @db.VarChar(80)
  bay          String             @default("") @db.VarChar(40)
  verified     Boolean            @default(false)
  attachments  Int                @default(0)
  status       GoodsReceiptStatus @default(draft)
  receivedById String             @map("received_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt     DateTime?          @map("posted_at") @db.Timestamptz(6)
  version      Int                @default(1)

  organisation  Organisation         @relation(fields: [orgId], references: [id])
  order         PurchaseOrder?       @relation(fields: [orderId], references: [id])
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  store         StockLocation        @relation(fields: [storeId], references: [id])
  receivedBy    User                 @relation("GoodsReceivedBy", fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]
  discrepancies ReceiptDiscrepancy[]

  @@unique([orgId, reference])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id        String @id @default(uuid(7)) @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  ordered   Int    @default(0)
  received  Int
  rejected  Int    @default(0)
  // Accepted units by batch: [{ batchNo, expiry, qty, bin }].
  batches   Json

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    StockItem    @relation(fields: [itemId], references: [id])

  @@map("goods_receipt_lines")
}

model ReceiptDiscrepancy {
  id         String  @id @default(uuid(7)) @db.Uuid
  receiptId  String  @map("receipt_id") @db.Uuid
  reference  String  @db.VarChar(20)
  kind       String  @db.VarChar(60)
  qty        Int
  // Unresolved, Documented or Resolved.
  state      String  @db.VarChar(20)
  note       String  @default("") @db.VarChar(1000)
  resolution String? @db.VarChar(120)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("receipt_discrepancies")
}

model StockAdjustment {
  id           String           @id @default(uuid(7)) @db.Uuid
  orgId        String           @map("org_id") @db.Uuid
  reference    String           @db.VarChar(20)
  itemId       String           @map("item_id") @db.Uuid
  batchId      String           @map("batch_id") @db.Uuid
  proposed     Int
  reason       String           @db.VarChar(200)
  evidence     String           @db.VarChar(300)
  status       AdjustmentStatus @default(draft)
  recordedById String           @map("recorded_by") @db.Uuid
  decidedById  String?          @map("decided_by") @db.Uuid
  decidedAt    DateTime?        @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  version      Int              @default(1)

  organisation Organisation @relation(fields: [orgId], references: [id])
  item         StockItem    @relation(fields: [itemId], references: [id])
  recordedBy   User         @relation("AdjustmentRecordedBy", fields: [recordedById], references: [id])
  decidedBy    User?        @relation("AdjustmentDecidedBy", fields: [decidedById], references: [id])

  @@unique([orgId, reference])
  @@map("stock_adjustments")
}

// Medicine handed over against a prescription, batch by batch.
model Dispense {
  id                String   @id @default(uuid(7)) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  reference         String   @db.VarChar(20)
  prescriptionId    String   @map("prescription_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  registerConfirmed Boolean  @default(false) @map("register_confirmed")
  consentConfirmed  Boolean  @default(false) @map("consent_confirmed")
  dispensedById     String   @map("dispensed_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation   @relation(fields: [orgId], references: [id])
  prescription Prescription   @relation(fields: [prescriptionId], references: [id])
  location     StockLocation  @relation(fields: [locationId], references: [id])
  dispensedBy  User           @relation("DispensedBy", fields: [dispensedById], references: [id])
  lines        DispenseLine[]

  @@unique([orgId, reference])
  @@index([prescriptionId])
  @@map("dispenses")
}

model DispenseLine {
  id                 String   @id @default(uuid(7)) @db.Uuid
  dispenseId         String   @map("dispense_id") @db.Uuid
  prescriptionItemId String   @map("prescription_item_id") @db.Uuid
  itemId             String   @map("item_id") @db.Uuid
  batchId            String   @map("batch_id") @db.Uuid
  batchNo            String   @map("batch_no") @db.VarChar(40)
  expiry             DateTime @db.Date
  bin                String   @default("") @db.VarChar(40)
  qty                Int
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)

  dispense Dispense  @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
  item     StockItem @relation(fields: [itemId], references: [id])

  @@index([prescriptionItemId])
  @@map("dispense_lines")
}

// A medicine return or a stock discrepancy reported by the pharmacy, reviewed to a decision.
model PharmacyCase {
  id           String             @id @default(uuid(7)) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  reference    String             @db.VarChar(20)
  // Return or Discrepancy.
  type         String             @db.VarChar(20)
  subtype      String             @db.VarChar(60)
  itemId       String             @map("item_id") @db.Uuid
  batchId      String?            @map("batch_id") @db.Uuid
  qty          Int
  origin       String             @db.VarChar(120)
  originNote   String             @default("") @map("origin_note") @db.VarChar(160)
  reason       String             @db.VarChar(120)
  reasonNote   String             @default("") @map("reason_note") @db.VarChar(160)
  location     String             @db.VarChar(120)
  expected     Int?
  observed     Int?
  notes        String             @default("") @db.VarChar(2000)
  evidence     Int                @default(0)
  status       PharmacyCaseStatus @default(awaiting_review)
  statusNote   String             @default("") @map("status_note") @db.VarChar(200)
  assigneeId   String?            @map("assignee_id") @db.Uuid
  reportedById String             @map("reported_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  version      Int                @default(1)

  organisation Organisation @relation(fields: [orgId], references: [id])
  item         StockItem    @relation(fields: [itemId], references: [id])
  assignee     User?        @relation("CaseAssignee", fields: [assigneeId], references: [id])
  reportedBy   User         @relation("CaseReportedBy", fields: [reportedById], references: [id])

  @@unique([orgId, reference])
  @@map("pharmacy_cases")
}

// ── Payroll ──────────────────────────────────────────────────────────────────────────────────────────────
// Amounts are whole paise and rates basis points (1200 = 12%), so every figure is exact.

enum PayEmployment {
  full_time
  part_time
  contract_locum
  consultant

  @@map("pay_employment")
}

enum PayModel {
  monthly
  visit
  shift
  hourly

  @@map("pay_model")
}

enum PayrollCycleStatus {
  draft
  approved
  processed

  @@map("payroll_cycle_status")
}

enum PayrollEntryStatus {
  ready
  needs_review
  on_hold

  @@map("payroll_entry_status")
}

enum PayAdjustmentStatus {
  pending
  approved
  rejected

  @@map("pay_adjustment_status")
}

enum AdvanceStatus {
  pending_approval
  pending_disbursal
  awaiting_acknowledgement
  active
  settled
  rejected

  @@map("advance_status")
}

// The organisation's statutory deduction rules. Professional-tax slabs are [{ above, amount }] in paise:
// the amount of the highest slab whose `above` the month's gross exceeds.
model PayrollSettings {
  orgId       String   @id @map("org_id") @db.Uuid
  epfEnabled  Boolean  @default(true) @map("epf_enabled")
  epfRateBp   Int      @default(1200) @map("epf_rate_bp")
  epfCap      Int      @default(180000) @map("epf_cap")
  esicEnabled Boolean  @default(true) @map("esic_enabled")
  esicRateBp  Int      @default(75) @map("esic_rate_bp")
  esicCeiling Int      @default(2100000) @map("esic_ceiling")
  ptEnabled   Boolean  @default(true) @map("pt_enabled")
  ptState     String   @default("Telangana") @map("pt_state") @db.VarChar(60)
  ptSlabs     Json     @map("pt_slabs")
  tdsEnabled  Boolean  @default(true) @map("tds_enabled")
  tdsRateBp   Int      @default(1000) @map("tds_rate_bp")
  // Salaries for a month are paid on this day of the following month.
  payDay      Int      @default(5) @map("pay_day")
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(1)

  organisation Organisation @relation(fields: [orgId], references: [id])
  updatedBy    User?        @relation("PayrollSettingsUpdatedBy", fields: [updatedById], references: [id])

  @@map("payroll_settings")
}

// How a staff member is paid. Only the bank name, IFSC and last four digits are kept, never the account number.
model PayProfile {
  id               String        @id @default(uuid(7)) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  staffId          String        @unique @map("staff_id") @db.Uuid
  employment       PayEmployment
  model            PayModel
  rate             Int
  bankName         String        @map("bank_name") @db.VarChar(80)
  ifsc             String        @db.VarChar(11)
  accountLast4     String        @map("account_last4") @db.VarChar(4)
  bankVerified     Boolean       @default(false) @map("bank_verified")
  bankVerifiedById String?       @map("bank_verified_by") @db.Uuid
  bankVerifiedAt   DateTime?     @map("bank_verified_at") @db.Timestamptz(6)
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int           @default(1)

  organisation   Organisation @relation(fields: [orgId], references: [id])
  staff          StaffMember  @relation(fields: [staffId], references: [id])
  bankVerifiedBy User?        @relation("PayProfileBankVerifiedBy", fields: [bankVerifiedById], references: [id])

  @@index([orgId])
  @@map("pay_profiles")
}

// One payroll run per month: draft → approved → processed. Totals are filled in when it is processed.
model PayrollCycle {
  id              String             @id @default(uuid(7)) @db.Uuid
  orgId           String             @map("org_id") @db.Uuid
  month           String             @db.VarChar(7)
  reference       String             @db.VarChar(20)
  status          PayrollCycleStatus @default(draft)
  scopeBranchIds  String[]           @map("scope_branch_ids") @db.Uuid
  scopeEmployment PayEmployment[]    @map("scope_employment")
  payDate         DateTime           @map("pay_date") @db.Date
  createdById     String             @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedById    String?            @map("approved_by") @db.Uuid
  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz(6)
  processedById   String?            @map("processed_by") @db.Uuid
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  staffCount      Int?               @map("staff_count")
  gross           Int?
  additions       Int?
  deductions      Int?
  statutory       Int?
  advances        Int?
  net             Int?
  version         Int                @default(1)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  createdBy    User                @relation("PayrollCycleCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?               @relation("PayrollCycleApprovedBy", fields: [approvedById], references: [id])
  processedBy  User?               @relation("PayrollCycleProcessedBy", fields: [processedById], references: [id])
  entries      PayrollEntry[]
  adjustments  PayrollAdjustment[]
  recoveries   AdvanceRecovery[]

  @@unique([orgId, month])
  @@unique([orgId, reference])
  @@map("payroll_cycles")
}

// A staff member's line in a cycle. While the cycle is open its figures are worked out from the records on every
// read; `entered` replaces the derived paid days or units (with a reason). Processing fixes the payslip columns.
model PayrollEntry {
  id            String             @id @default(uuid(7)) @db.Uuid
  cycleId       String             @map("cycle_id") @db.Uuid
  staffId       String             @map("staff_id") @db.Uuid
  included      Boolean            @default(true)
  status        PayrollEntryStatus @default(ready)
  statusNote    String             @default("") @map("status_note") @db.VarChar(300)
  entered       Int?
  enteredReason String?            @map("entered_reason") @db.VarChar(300)
  // The payslip, fixed when the cycle is processed.
  payslipRef    String?            @map("payslip_ref") @db.VarChar(20)
  branchId      String?            @map("branch_id") @db.Uuid
  employment    PayEmployment?
  model         PayModel?
  rate          Int?
  quantity      Int?
  quantityNote  String?            @map("quantity_note") @db.VarChar(300)
  gross         Int?
  additions     Int?
  deductions    Int?
  statutory     Json?
  advance       Int?
  net           Int?
  paymentRef    String?            @map("payment_ref") @db.VarChar(60)
  paidAt        DateTime?          @map("paid_at") @db.Timestamptz(6)
  paidById      String?            @map("paid_by") @db.Uuid
  version       Int                @default(1)

  cycle      PayrollCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  staff      StaffMember       @relation(fields: [staffId], references: [id])
  branch     Branch?           @relation(fields: [branchId], references: [id])
  paidBy     User?             @relation("PayrollEntryPaidBy", fields: [paidById], references: [id])
  recoveries AdvanceRecovery[]

  @@unique([cycleId, staffId])
  @@map("payroll_entries")
}

// An addition or deduction for a month. Approved ones are applied by the first cycle processed for that month or
// later, which records itself in `cycleId`.
model PayrollAdjustment {
  id            String              @id @default(uuid(7)) @db.Uuid
  orgId         String              @map("org_id") @db.Uuid
  reference     String              @db.VarChar(20)
  staffId       String              @map("staff_id") @db.Uuid
  month         String              @db.VarChar(7)
  direction     String              @db.VarChar(10)
  category      String              @db.VarChar(60)
  label         String              @db.VarChar(120)
  amount        Int
  reason        String              @db.VarChar(1000)
  documentRef   String?             @map("document_ref") @db.VarChar(80)
  status        PayAdjustmentStatus @default(pending)
  requestedById String              @map("requested_by") @db.Uuid
  decidedById   String?             @map("decided_by") @db.Uuid
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(6)
  comment       String?             @db.VarChar(500)
  cycleId       String?             @map("cycle_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  version       Int                 @default(1)

  organisation Organisation  @relation(fields: [orgId], references: [id])
  staff        StaffMember   @relation(fields: [staffId], references: [id])
  requestedBy  User          @relation("PayAdjustmentRequestedBy", fields: [requestedById], references: [id])
  decidedBy    User?         @relation("PayAdjustmentDecidedBy", fields: [decidedById], references: [id])
  cycle        PayrollCycle? @relation(fields: [cycleId], references: [id])

  @@unique([orgId, reference])
  @@index([orgId, month])
  @@map("payroll_adjustments")
}

// A salary advance, recovered in equal monthly instalments (the last takes the remainder) once active.
model PayrollAdvance {
  id             String        @id @default(uuid(7)) @db.Uuid
  orgId          String        @map("org_id") @db.Uuid
  reference      String        @db.VarChar(20)
  staffId        String        @map("staff_id") @db.Uuid
  principal      Int
  installments   Int
  startMonth     String        @map("start_month") @db.VarChar(7)
  source         String        @db.VarChar(30)
  category       String        @db.VarChar(60)
  method         String?       @db.VarChar(40)
  notes          String        @default("") @db.VarChar(1000)
  status         AdvanceStatus
  disbursalDate  DateTime?     @map("disbursal_date") @db.Date
  decisionNote   String?       @map("decision_note") @db.VarChar(500)
  createdById    String        @map("created_by") @db.Uuid
  approvedById   String?       @map("approved_by") @db.Uuid
  approvedAt     DateTime?     @map("approved_at") @db.Timestamptz(6)
  disbursedAt    DateTime?     @map("disbursed_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?     @map("acknowledged_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  version        Int           @default(1)

  organisation Organisation      @relation(fields: [orgId], references: [id])
  staff        StaffMember       @relation(fields: [staffId], references: [id])
  createdBy    User              @relation("AdvanceCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?             @relation("AdvanceApprovedBy", fields: [approvedById], references: [id])
  recoveries   AdvanceRecovery[]

  @@unique([orgId, reference])
  @@map("payroll_advances")
}

// An instalment taken from a payslip.
model AdvanceRecovery {
  id        String   @id @default(uuid(7)) @db.Uuid
  advanceId String   @map("advance_id") @db.Uuid
  cycleId   String   @map("cycle_id") @db.Uuid
  entryId   String   @map("entry_id") @db.Uuid
  number    Int
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  advance PayrollAdvance @relation(fields: [advanceId], references: [id])
  cycle   PayrollCycle   @relation(fields: [cycleId], references: [id])
  entry   PayrollEntry   @relation(fields: [entryId], references: [id])

  @@unique([advanceId, cycleId])
  @@unique([advanceId, number])
  @@map("advance_recoveries")
}

model PayrollEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(30)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(120)
  note       String   @default("") @db.VarChar(1000)
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  actor        User?        @relation("PayrollEventActor", fields: [actorId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@map("payroll_events")
}

// ─── Growth: leads ──────────────────────────────────────────────────────────

enum LeadStage {
  new
  contacted
  qualified
  converted
  closed

  @@map("lead_stage")
}

enum LeadSource {
  website
  phone
  front_desk
  walk_in

  @@map("lead_source")
}

enum LeadActivityKind {
  created
  updated
  interaction
  converted
  disposition

  @@map("lead_activity_kind")
}

// An enquiry from someone who is not (yet) a patient. Converting links it to one shared patient record;
// the original source stays as it was recorded.
model Lead {
  id                String     @id @default(uuid(7)) @db.Uuid
  orgId             String     @map("org_id") @db.Uuid
  number            String     @db.VarChar(20)
  branchId          String     @map("branch_id") @db.Uuid
  fullName          String     @map("full_name") @db.VarChar(120)
  mobile            String     @db.VarChar(10)
  email             String?    @db.VarChar(254)
  interest          String?    @db.VarChar(120)
  source            LeadSource
  stage             LeadStage  @default(new)
  ownerMembershipId String     @map("owner_membership_id") @db.Uuid
  // The open follow-up task, if any.
  nextAction        String?    @map("next_action") @db.VarChar(200)
  nextDueAt         DateTime?  @map("next_due_at") @db.Timestamptz(6)
  // The campaign the enquiry was recorded against; set once and never rewritten.
  campaignId        String?    @map("campaign_id") @db.Uuid
  patientId         String?    @map("patient_id") @db.Uuid
  convertedAt       DateTime?  @map("converted_at") @db.Timestamptz(6)
  convertedById     String?    @map("converted_by") @db.Uuid
  lastActivityAt    DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdById       String     @map("created_by") @db.Uuid
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation  Organisation     @relation(fields: [orgId], references: [id])
  branch        Branch           @relation(fields: [branchId], references: [id])
  owner         Membership       @relation("LeadOwner", fields: [ownerMembershipId], references: [id])
  patient       Patient?         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  convertedBy   User?            @relation("LeadConvertedBy", fields: [convertedById], references: [id])
  createdBy     User             @relation("LeadCreatedBy", fields: [createdById], references: [id])
  activities    LeadActivity[]
  conversations Conversation[]
  consents      ContactConsent[]

  broadcastRecipients BroadcastRecipient[]
  workflowRuns        WorkflowRun[]

  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@unique([orgId, number])
  @@index([orgId, branchId, stage])
  @@index([orgId, mobile])
  @@index([orgId, nextDueAt])
  @@index([orgId, createdAt])
  @@index([orgId, campaignId])
  @@map("leads")
}

// Append-only history of a lead: what changed, who did it and when.
model LeadActivity {
  id                String           @id @default(uuid(7)) @db.Uuid
  orgId             String           @map("org_id") @db.Uuid
  leadId            String           @map("lead_id") @db.Uuid
  kind              LeadActivityKind
  title             String           @db.VarChar(160)
  text              String           @db.VarChar(2000)
  // Interaction type and outcome, or the old → new values of an edit.
  details           Json?
  // When it happened (an interaction can be logged after the call); createdAt is when it was recorded.
  occurredAt        DateTime         @map("occurred_at") @db.Timestamptz(6)
  ownerMembershipId String?          @map("owner_membership_id") @db.Uuid
  actorId           String?          @map("actor_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  lead         Lead         @relation(fields: [leadId], references: [id])
  owner        Membership?  @relation("LeadActivityOwner", fields: [ownerMembershipId], references: [id])
  actor        User?        @relation("LeadActivityActor", fields: [actorId], references: [id])

  @@index([leadId, occurredAt])
  @@map("lead_activities")
}

// ─── Growth: messaging ──────────────────────────────────────────────────────

enum MessageChannel {
  whatsapp
  sms
  email

  @@map("message_channel")
}

enum ChannelStatus {
  not_connected
  connected
  error

  @@map("channel_status")
}

// One provider connection per channel per organisation: WhatsApp Cloud API, MSG91 or SMTP.
model MessagingChannel {
  id           String         @id @default(uuid(7)) @db.Uuid
  orgId        String         @map("org_id") @db.Uuid
  channel      MessageChannel
  status       ChannelStatus  @default(not_connected)
  // Non-secret settings (phone number id, sender id, SMTP host); shown back to administrators.
  config       Json           @default("{}")
  // AES-256-GCM ciphertext of the access token, app secret, auth key or SMTP password. Never returned by the API.
  secret       String?        @db.Text
  // Random values the provider echoes back, proving a webhook call is for this channel.
  webhookToken String         @map("webhook_token") @db.VarChar(64)
  verifiedAt   DateTime?      @map("verified_at") @db.Timestamptz(6)
  lastError    String?        @map("last_error") @db.VarChar(500)
  updatedById  String?        @map("updated_by") @db.Uuid
  version      Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  updatedBy    User?        @relation("ChannelUpdatedBy", fields: [updatedById], references: [id])

  @@unique([orgId, channel])
  @@unique([webhookToken])
  @@map("messaging_channels")
}

enum TemplateStatus {
  draft
  approved
  retired

  @@map("template_status")
}

model MessageTemplate {
  id          String         @id @default(uuid(7)) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  code        String         @db.VarChar(20)
  name        String         @db.VarChar(120)
  category    String         @db.VarChar(40)
  channel     MessageChannel
  locale      String         @db.VarChar(10)
  subject     String?        @db.VarChar(160)
  body        String         @db.VarChar(2000)
  status      TemplateStatus @default(draft)
  // The provider's approved template: WhatsApp template name, or the MSG91 flow / DLT template id.
  providerRef String?        @map("provider_ref") @db.VarChar(120)
  version     Int            @default(1)
  changeNote  String?        @map("change_note") @db.VarChar(500)
  updatedById String?        @map("updated_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  updatedBy    User?        @relation("TemplateUpdatedBy", fields: [updatedById], references: [id])
  messages     Message[]

  broadcasts CampaignBroadcast[]
  workflows  Workflow[]

  @@unique([orgId, code])
  @@map("message_templates")
}

enum ConsentStatus {
  granted
  withdrawn

  @@map("consent_status")
}

// Append-only: the latest entry for an address and channel is the current permission to send marketing.
model ContactConsent {
  id           String         @id @default(uuid(7)) @db.Uuid
  orgId        String         @map("org_id") @db.Uuid
  channel      MessageChannel
  // A 10-digit mobile for WhatsApp and SMS, or a lower-cased email address.
  address      String         @db.VarChar(254)
  status       ConsentStatus
  source       String         @db.VarChar(40)
  note         String?        @db.VarChar(500)
  leadId       String?        @map("lead_id") @db.Uuid
  patientId    String?        @map("patient_id") @db.Uuid
  recordedById String?        @map("recorded_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])
  recordedBy   User?        @relation("ConsentRecordedBy", fields: [recordedById], references: [id])

  @@index([orgId, channel, address, createdAt])
  @@map("contact_consents")
}

enum ConversationStatus {
  open
  resolved

  @@map("conversation_status")
}

// Every message with one address on one channel. Linked to a lead or patient when staff start it from one, or
// when someone links it; an enquiry from an unknown number stays unlinked.
model Conversation {
  id                String             @id @default(uuid(7)) @db.Uuid
  orgId             String             @map("org_id") @db.Uuid
  number            String             @db.VarChar(20)
  channel           MessageChannel
  address           String             @db.VarChar(254)
  branchId          String?            @map("branch_id") @db.Uuid
  leadId            String?            @map("lead_id") @db.Uuid
  patientId         String?            @map("patient_id") @db.Uuid
  status            ConversationStatus @default(open)
  ownerMembershipId String?            @map("owner_membership_id") @db.Uuid
  unread            Boolean            @default(false)
  lastMessageAt     DateTime?          @map("last_message_at") @db.Timestamptz(6)
  // When the contact last wrote: WhatsApp allows free-text replies for 24 hours after it.
  lastInboundAt     DateTime?          @map("last_inbound_at") @db.Timestamptz(6)
  preview           String?            @db.VarChar(160)
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [orgId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  lead         Lead?              @relation(fields: [leadId], references: [id])
  patient      Patient?           @relation(fields: [patientId], references: [id])
  owner        Membership?        @relation("ConversationOwner", fields: [ownerMembershipId], references: [id])
  messages     Message[]
  notes        ConversationNote[]

  @@unique([orgId, channel, address])
  @@unique([orgId, number])
  @@index([orgId, lastMessageAt])
  @@map("conversations")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

// A person typing in the inbox, a campaign broadcast or a workflow. Automated ones count towards the weekly cap.
enum MessageOrigin {
  manual
  broadcast
  workflow

  @@map("message_origin")
}

// queued → sending → sent → delivered → read, or failed. `unknown` means the provider may or may not have
// accepted it (for example a timeout after sending): it is never resent automatically.
enum MessageStatus {
  queued
  sending
  sent
  delivered
  read
  failed
  unknown
  received

  @@map("message_status")
}

model Message {
  id                String           @id @default(uuid(7)) @db.Uuid
  orgId             String           @map("org_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  direction         MessageDirection
  status            MessageStatus
  body              String           @db.VarChar(4000)
  subject           String?          @db.VarChar(160)
  templateId        String?          @map("template_id") @db.Uuid
  templateVersion   Int?             @map("template_version")
  // Template variable values in order, as sent to the provider.
  parameters        Json?
  providerMessageId String?          @map("provider_message_id") @db.VarChar(200)
  errorCode         String?          @map("error_code") @db.VarChar(80)
  errorMessage      String?          @map("error_message") @db.VarChar(500)
  attempts          Int              @default(0)
  nextAttemptAt     DateTime?        @map("next_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?        @map("delivered_at") @db.Timestamptz(6)
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  failedAt          DateTime?        @map("failed_at") @db.Timestamptz(6)
  sentById          String?          @map("sent_by") @db.Uuid
  origin            MessageOrigin    @default(manual)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation     @relation(fields: [orgId], references: [id])
  conversation Conversation     @relation(fields: [conversationId], references: [id])
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  sentBy       User?            @relation("MessageSentBy", fields: [sentById], references: [id])

  broadcastRecipient BroadcastRecipient?
  workflowRun        WorkflowRun?

  @@unique([orgId, providerMessageId])
  @@index([conversationId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("messages")
}

// Staff notes on a conversation; never sent to the contact.
model ConversationNote {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  text           String   @db.VarChar(2000)
  authorId       String   @map("author_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  author       User         @relation("ConversationNoteAuthor", fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
  @@map("conversation_notes")
}

// ─── Growth: audiences, campaigns and workflows ─────────────────────────────

enum AudienceStatus {
  draft
  ready
  archived

  @@map("audience_status")
}

// Rules over leads and patients. Members are worked out from the records whenever the audience is counted or sent
// to; they are never stored, so the list is always current.
model Audience {
  id          String         @id @default(uuid(7)) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  code        String         @db.VarChar(20)
  name        String         @db.VarChar(120)
  purpose     String         @db.VarChar(500)
  // Null covers every branch; only organisation-wide roles may create one.
  branchId    String?        @map("branch_id") @db.Uuid
  status      AudienceStatus @default(draft)
  rules       Json
  version     Int            @default(1)
  createdById String         @map("created_by") @db.Uuid
  updatedById String?        @map("updated_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  branch       Branch?             @relation(fields: [branchId], references: [id])
  createdBy    User                @relation("AudienceCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?               @relation("AudienceUpdatedBy", fields: [updatedById], references: [id])
  versions     AudienceVersion[]
  campaigns    Campaign[]
  broadcasts   CampaignBroadcast[]

  @@unique([orgId, code])
  @@map("audiences")
}

// Append-only: every saved set of rules, with why it changed.
model AudienceVersion {
  id         String   @id @default(uuid(7)) @db.Uuid
  audienceId String   @map("audience_id") @db.Uuid
  version    Int
  rules      Json
  changeNote String   @map("change_note") @db.VarChar(500)
  actorId    String   @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  audience Audience @relation(fields: [audienceId], references: [id])
  actor    User     @relation("AudienceVersionActor", fields: [actorId], references: [id])

  @@unique([audienceId, version])
  @@map("audience_versions")
}

enum CampaignChannel {
  paid_search
  meta_ads
  whatsapp
  sms
  email
  phone

  @@map("campaign_channel")
}

enum CampaignStatus {
  draft
  scheduled
  active
  paused
  completed

  @@map("campaign_status")
}

model Campaign {
  id                String          @id @default(uuid(7)) @db.Uuid
  orgId             String          @map("org_id") @db.Uuid
  code              String          @db.VarChar(20)
  name              String          @db.VarChar(120)
  objective         String          @db.VarChar(300)
  channel           CampaignChannel
  status            CampaignStatus  @default(draft)
  branchId          String          @map("branch_id") @db.Uuid
  ownerMembershipId String          @map("owner_membership_id") @db.Uuid
  audienceId        String?         @map("audience_id") @db.Uuid
  budget            Decimal         @db.Decimal(12, 2)
  startDate         DateTime        @map("start_date") @db.Date
  endDate           DateTime        @map("end_date") @db.Date
  cta               String          @db.VarChar(120)
  landingUrl        String          @map("landing_url") @db.VarChar(500)
  version           Int             @default(1)
  createdById       String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  branch       Branch              @relation(fields: [branchId], references: [id])
  owner        Membership          @relation("CampaignOwner", fields: [ownerMembershipId], references: [id])
  audience     Audience?           @relation(fields: [audienceId], references: [id])
  createdBy    User                @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  leads        Lead[]
  spend        CampaignSpend[]
  events       CampaignEvent[]
  broadcasts   CampaignBroadcast[]

  @@unique([orgId, code])
  @@index([orgId, startDate])
  @@map("campaigns")
}

// Money actually spent, entered by hand from the ad platform or invoice. Corrections are new negative entries.
model CampaignSpend {
  id           String   @id @default(uuid(7)) @db.Uuid
  campaignId   String   @map("campaign_id") @db.Uuid
  spentOn      DateTime @map("spent_on") @db.Date
  amount       Decimal  @db.Decimal(12, 2)
  note         String   @db.VarChar(300)
  recordedById String   @map("recorded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign   Campaign @relation(fields: [campaignId], references: [id])
  recordedBy User     @relation("CampaignSpendRecordedBy", fields: [recordedById], references: [id])

  @@index([campaignId, spentOn])
  @@map("campaign_spend")
}

// The campaign's history: created, changed (old → new and why), spend, broadcasts.
model CampaignEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  kind       String   @db.VarChar(40)
  text       String   @db.VarChar(1000)
  details    Json?
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id])
  actor    User?    @relation("CampaignEventActor", fields: [actorId], references: [id])

  @@index([campaignId, createdAt])
  @@map("campaign_events")
}

enum BroadcastStatus {
  scheduled
  sending
  completed
  cancelled

  @@map("broadcast_status")
}

// One send of an approved template to a campaign's audience. Recipients are worked out when it starts, with
// consent and opt-outs checked again for each person then.
model CampaignBroadcast {
  id                 String          @id @default(uuid(7)) @db.Uuid
  orgId              String          @map("org_id") @db.Uuid
  campaignId         String          @map("campaign_id") @db.Uuid
  audienceId         String          @map("audience_id") @db.Uuid
  audienceVersion    Int             @map("audience_version")
  templateId         String          @map("template_id") @db.Uuid
  templateVersion    Int             @map("template_version")
  channel            MessageChannel
  // Values for template variables ClinicOS cannot fill per person, the same for everyone.
  variables          Json
  status             BroadcastStatus @default(scheduled)
  scheduledAt        DateTime        @map("scheduled_at") @db.Timestamptz(6)
  // Set while a worker is working through it; an old claim means that worker stopped.
  claimedAt          DateTime?       @map("claimed_at") @db.Timestamptz(6)
  startedAt          DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)
  // At most this many automated messages to one person in 7 days, counting this one.
  weeklyCap          Int             @default(2) @map("weekly_cap")
  // The reachable count shown when it was confirmed.
  expectedRecipients Int             @map("expected_recipients")
  queuedCount        Int             @default(0) @map("queued_count")
  skippedCount       Int             @default(0) @map("skipped_count")
  createdById        String          @map("created_by") @db.Uuid
  cancelledById      String?         @map("cancelled_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation         @relation(fields: [orgId], references: [id])
  campaign     Campaign             @relation(fields: [campaignId], references: [id])
  audience     Audience             @relation(fields: [audienceId], references: [id])
  template     MessageTemplate      @relation(fields: [templateId], references: [id])
  createdBy    User                 @relation("BroadcastCreatedBy", fields: [createdById], references: [id])
  cancelledBy  User?                @relation("BroadcastCancelledBy", fields: [cancelledById], references: [id])
  recipients   BroadcastRecipient[]

  @@index([status, scheduledAt])
  @@index([campaignId, createdAt])
  @@map("campaign_broadcasts")
}

// One address a broadcast reached or skipped. The unique address keeps a resumed broadcast from sending twice.
model BroadcastRecipient {
  id          String   @id @default(uuid(7)) @db.Uuid
  broadcastId String   @map("broadcast_id") @db.Uuid
  address     String   @db.VarChar(254)
  leadId      String?  @map("lead_id") @db.Uuid
  patientId   String?  @map("patient_id") @db.Uuid
  messageId   String?  @unique @map("message_id") @db.Uuid
  skipReason  String?  @map("skip_reason") @db.VarChar(40)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  broadcast CampaignBroadcast @relation(fields: [broadcastId], references: [id])
  lead      Lead?             @relation(fields: [leadId], references: [id])
  patient   Patient?          @relation(fields: [patientId], references: [id])
  message   Message?          @relation(fields: [messageId], references: [id])

  @@unique([broadcastId, address])
  @@map("broadcast_recipients")
}

enum WorkflowTrigger {
  no_show
  lead_not_booked
  revisit_due
  // A completed visit, asking for honest feedback with the branch's public review link.
  review_request

  @@map("workflow_trigger")
}

enum WorkflowStatus {
  draft
  active
  paused

  @@map("workflow_status")
}

// Sends one template automatically when something happens: a missed appointment, a lead that has not booked, a
// visit some days ago. Only events falling due after it was switched on are acted on.
model Workflow {
  id                String          @id @default(uuid(7)) @db.Uuid
  orgId             String          @map("org_id") @db.Uuid
  code              String          @db.VarChar(20)
  name              String          @db.VarChar(120)
  trigger           WorkflowTrigger
  // How long after the event to send.
  delayHours        Int             @map("delay_hours")
  // Null covers every branch; only organisation-wide roles may set that.
  branchId          String?         @map("branch_id") @db.Uuid
  templateId        String?         @map("template_id") @db.Uuid
  variables         Json            @default("{}")
  // At most this many automated messages to one person in 7 days, counting broadcasts and other workflows.
  weeklyCap         Int             @default(2) @map("weekly_cap")
  status            WorkflowStatus  @default(draft)
  ownerMembershipId String          @map("owner_membership_id") @db.Uuid
  activatedAt       DateTime?       @map("activated_at") @db.Timestamptz(6)
  activatedById     String?         @map("activated_by") @db.Uuid
  version           Int             @default(1)
  changeNote        String?         @map("change_note") @db.VarChar(500)
  createdById       String          @map("created_by") @db.Uuid
  updatedById       String?         @map("updated_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation     @relation(fields: [orgId], references: [id])
  branch       Branch?          @relation(fields: [branchId], references: [id])
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  owner        Membership       @relation("WorkflowOwner", fields: [ownerMembershipId], references: [id])
  activatedBy  User?            @relation("WorkflowActivatedBy", fields: [activatedById], references: [id])
  createdBy    User             @relation("WorkflowCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?            @relation("WorkflowUpdatedBy", fields: [updatedById], references: [id])
  runs         WorkflowRun[]

  @@unique([orgId, code])
  @@index([status])
  @@map("workflows")
}

enum WorkflowRunOutcome {
  queued
  skipped

  @@map("workflow_run_outcome")
}

// What a workflow did for one event. The unique subject means each missed appointment, lead or visit is acted on
// once, however often the worker runs.
model WorkflowRun {
  id              String             @id @default(uuid(7)) @db.Uuid
  orgId           String             @map("org_id") @db.Uuid
  workflowId      String             @map("workflow_id") @db.Uuid
  workflowVersion Int                @map("workflow_version")
  subjectKey      String             @map("subject_key") @db.VarChar(80)
  leadId          String?            @map("lead_id") @db.Uuid
  patientId       String?            @map("patient_id") @db.Uuid
  appointmentId   String?            @map("appointment_id") @db.Uuid
  dueAt           DateTime           @map("due_at") @db.Timestamptz(6)
  outcome         WorkflowRunOutcome
  skipReason      String?            @map("skip_reason") @db.VarChar(40)
  messageId       String?            @unique @map("message_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  workflow     Workflow     @relation(fields: [workflowId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  message      Message?     @relation(fields: [messageId], references: [id])

  @@unique([workflowId, subjectKey])
  @@index([orgId, createdAt])
  @@map("workflow_runs")
}

// ─── Growth: content, business profiles and reviews ─────────────────────────

enum IntegrationProvider {
  meta
  google

  @@map("integration_provider")
}

// Each organisation's Meta (Facebook Page + Instagram) and Google Business Profile connection. Credentials are
// encrypted with MESSAGING_SECRET_KEY and never returned.
model GrowthIntegration {
  id          String              @id @default(uuid(7)) @db.Uuid
  orgId       String              @map("org_id") @db.Uuid
  provider    IntegrationProvider
  status      ChannelStatus       @default(not_connected)
  config      Json                @default("{}")
  secret      String?
  verifiedAt  DateTime?           @map("verified_at") @db.Timestamptz(6)
  // What the provider reported when checked, for example the Page name.
  description String?             @db.VarChar(200)
  lastError   String?             @map("last_error") @db.VarChar(500)
  updatedById String?             @map("updated_by") @db.Uuid
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])

  @@unique([orgId, provider])
  @@map("growth_integrations")
}

// An uploaded image (JPEG, PNG or WebP, at most 5 MB). Served to Meta through a signed, expiring link.
model MediaAsset {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  fileName    String   @map("file_name") @db.VarChar(200)
  mimeType    String   @map("mime_type") @db.VarChar(40)
  size        Int
  data        Bytes
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [orgId], references: [id])
  posts        ContentPost[]

  @@map("media_assets")
}

enum ContentTarget {
  facebook
  instagram

  @@map("content_target")
}

// Reusable post copy. Saving moves the version on; posts record the version they started from.
model ContentTemplate {
  id          String          @id @default(uuid(7)) @db.Uuid
  orgId       String          @map("org_id") @db.Uuid
  code        String          @db.VarChar(20)
  title       String          @db.VarChar(120)
  category    String          @db.VarChar(40)
  body        String          @db.VarChar(2200)
  cta         String          @db.VarChar(120)
  targets     ContentTarget[]
  archived    Boolean         @default(false)
  version     Int             @default(1)
  updatedById String?         @map("updated_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [orgId], references: [id])
  updatedBy    User?         @relation("ContentTemplateUpdatedBy", fields: [updatedById], references: [id])
  posts        ContentPost[]

  @@unique([orgId, code])
  @@map("content_templates")
}

// draft → in_review (submitted with a time) → scheduled (approved by a different person) → publishing →
// published, or failed. Only a draft can be edited; a rejected or failed post goes back to draft.
enum ContentStatus {
  draft
  in_review
  scheduled
  publishing
  published
  failed

  @@map("content_status")
}

model ContentPost {
  id                String          @id @default(uuid(7)) @db.Uuid
  orgId             String          @map("org_id") @db.Uuid
  code              String          @db.VarChar(20)
  branchId          String          @map("branch_id") @db.Uuid
  title             String          @db.VarChar(120)
  category          String          @db.VarChar(40)
  caption           String          @db.VarChar(2200)
  targets           ContentTarget[]
  cta               String          @db.VarChar(120)
  url               String          @db.VarChar(500)
  altText           String          @map("alt_text") @db.VarChar(1000)
  mediaId           String?         @map("media_id") @db.Uuid
  templateId        String?         @map("template_id") @db.Uuid
  templateVersion   Int?            @map("template_version")
  scheduledAt       DateTime?       @map("scheduled_at") @db.Timestamptz(6)
  status            ContentStatus   @default(draft)
  rightsReviewed    Boolean         @default(false) @map("rights_reviewed")
  ownerMembershipId String          @map("owner_membership_id") @db.Uuid
  submittedById     String?         @map("submitted_by") @db.Uuid
  submittedAt       DateTime?       @map("submitted_at") @db.Timestamptz(6)
  approvedById      String?         @map("approved_by") @db.Uuid
  approvedAt        DateTime?       @map("approved_at") @db.Timestamptz(6)
  // Why it was sent back, when a reviewer rejected it.
  reviewNote        String?         @map("review_note") @db.VarChar(500)
  claimedAt         DateTime?       @map("claimed_at") @db.Timestamptz(6)
  publishedAt       DateTime?       @map("published_at") @db.Timestamptz(6)
  version           Int             @default(1)
  createdById       String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation         @relation(fields: [orgId], references: [id])
  branch       Branch               @relation(fields: [branchId], references: [id])
  media        MediaAsset?          @relation(fields: [mediaId], references: [id])
  template     ContentTemplate?     @relation(fields: [templateId], references: [id])
  owner        Membership           @relation("ContentOwner", fields: [ownerMembershipId], references: [id])
  submittedBy  User?                @relation("ContentSubmittedBy", fields: [submittedById], references: [id])
  approvedBy   User?                @relation("ContentApprovedBy", fields: [approvedById], references: [id])
  createdBy    User                 @relation("ContentCreatedBy", fields: [createdById], references: [id])
  publications ContentPublication[]
  events       ContentEvent[]

  @@unique([orgId, code])
  @@index([orgId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("content_posts")
}

enum PublicationStatus {
  pending
  publishing
  published
  failed
  unknown

  @@map("publication_status")
}

// The post on one network. `unknown` (a timeout after sending) is never retried automatically.
model ContentPublication {
  id             String            @id @default(uuid(7)) @db.Uuid
  postId         String            @map("post_id") @db.Uuid
  target         ContentTarget
  status         PublicationStatus @default(pending)
  providerPostId String?           @map("provider_post_id") @db.VarChar(200)
  permalink      String?           @db.VarChar(500)
  errorCode      String?           @map("error_code") @db.VarChar(80)
  errorMessage   String?           @map("error_message") @db.VarChar(500)
  attempts       Int               @default(0)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  post ContentPost @relation(fields: [postId], references: [id])

  @@unique([postId, target])
  @@map("content_publications")
}

// The post's history: saved, submitted, approved or sent back, published, failed.
model ContentEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  kind      String   @db.VarChar(40)
  text      String   @db.VarChar(1000)
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post  ContentPost @relation(fields: [postId], references: [id])
  actor User?       @relation("ContentEventActor", fields: [actorId], references: [id])

  @@index([postId, createdAt])
  @@map("content_events")
}

// What the clinic publishes about a branch: address, description, categories, public review link, and the Google
// Business Profile location it is synced to.
model BranchProfile {
  id                String    @id @default(uuid(7)) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  branchId          String    @unique @map("branch_id") @db.Uuid
  businessName      String    @map("business_name") @db.VarChar(120)
  street            String    @db.VarChar(240)
  city              String    @db.VarChar(80)
  state             String    @db.VarChar(80)
  postalCode        String    @map("postal_code") @db.Char(6)
  country           String    @default("India") @db.VarChar(60)
  description       String    @default("") @db.VarChar(750)
  primaryCategory   String    @map("primary_category") @db.VarChar(80)
  secondaryCategory String?   @map("secondary_category") @db.VarChar(80)
  phone             String?   @db.VarChar(10)
  websiteUrl        String?   @map("website_url") @db.VarChar(500)
  // The public "write a review" link used by review requests.
  reviewUrl         String?   @map("review_url") @db.VarChar(500)
  // Google Business Profile location, "locations/1234567890".
  googleLocation    String?   @map("google_location") @db.VarChar(120)
  syncedAt          DateTime? @map("synced_at") @db.Timestamptz(6)
  syncError         String?   @map("sync_error") @db.VarChar(500)
  reviewsSyncedAt   DateTime? @map("reviews_synced_at") @db.Timestamptz(6)
  version           Int       @default(1)
  updatedById       String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation   @relation(fields: [orgId], references: [id])
  branch       Branch         @relation(fields: [branchId], references: [id])
  updatedBy    User?          @relation("BranchProfileUpdatedBy", fields: [updatedById], references: [id])
  specialHours SpecialHours[]

  @@map("branch_profiles")
}

// One day's exception to the regular hours: different hours, or closed.
model SpecialHours {
  id        String   @id @default(uuid(7)) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  date      DateTime @db.Date
  closed    Boolean  @default(false)
  opensAt   String?  @map("opens_at") @db.VarChar(5)
  closesAt  String?  @map("closes_at") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile BranchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@map("special_hours")
}

// A public review, as Google reported it. Reviewer names are public display names, never linked to patients.
model Review {
  id                String    @id @default(uuid(7)) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  source            String    @default("google") @db.VarChar(20)
  providerReviewId  String    @map("provider_review_id") @db.VarChar(300)
  reviewerName      String    @map("reviewer_name") @db.VarChar(120)
  rating            Int
  comment           String?   @db.VarChar(4096)
  postedAt          DateTime  @map("posted_at") @db.Timestamptz(6)
  providerUpdatedAt DateTime  @map("provider_updated_at") @db.Timestamptz(6)
  // The reply currently shown on Google, however it was posted.
  publicReply       String?   @map("public_reply") @db.VarChar(4096)
  publicReplyAt     DateTime? @map("public_reply_at") @db.Timestamptz(6)
  syncedAt          DateTime  @map("synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation    @relation(fields: [orgId], references: [id])
  branch       Branch          @relation(fields: [branchId], references: [id])
  response     ReviewResponse?
  notes        ReviewNote[]
  escalations  Escalation[]

  @@unique([orgId, providerReviewId])
  @@index([orgId, branchId, postedAt])
  @@map("reviews")
}

// draft → in_review → posting (approved by a different person) → posted, or failed (back to draft to fix).
enum ResponseStatus {
  draft
  in_review
  posting
  posted
  failed

  @@map("response_status")
}

model ReviewResponse {
  id            String         @id @default(uuid(7)) @db.Uuid
  reviewId      String         @unique @map("review_id") @db.Uuid
  text          String         @db.VarChar(4096)
  status        ResponseStatus @default(draft)
  submittedById String?        @map("submitted_by") @db.Uuid
  submittedAt   DateTime?      @map("submitted_at") @db.Timestamptz(6)
  approvedById  String?        @map("approved_by") @db.Uuid
  approvedAt    DateTime?      @map("approved_at") @db.Timestamptz(6)
  postedAt      DateTime?      @map("posted_at") @db.Timestamptz(6)
  reviewNote    String?        @map("review_note") @db.VarChar(500)
  errorMessage  String?        @map("error_message") @db.VarChar(500)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  review      Review @relation(fields: [reviewId], references: [id])
  submittedBy User?  @relation("ReviewResponseSubmittedBy", fields: [submittedById], references: [id])
  approvedBy  User?  @relation("ReviewResponseApprovedBy", fields: [approvedById], references: [id])

  @@map("review_responses")
}

// Internal notes on a review; never public.
model ReviewNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  text      String   @db.VarChar(2000)
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id])
  author User   @relation("ReviewNoteAuthor", fields: [authorId], references: [id])

  @@index([reviewId, createdAt])
  @@map("review_notes")
}

enum EscalationSeverity {
  low
  medium
  high

  @@map("escalation_severity")
}

enum EscalationStatus {
  open
  in_progress
  resolved

  @@map("escalation_status")
}

// Operations follow-up on a review. Independent of the public reply: resolving one never posts anything.
model Escalation {
  id                String             @id @default(uuid(7)) @db.Uuid
  orgId             String             @map("org_id") @db.Uuid
  code              String             @db.VarChar(20)
  reviewId          String             @map("review_id") @db.Uuid
  topic             String             @db.VarChar(120)
  severity          EscalationSeverity
  ownerMembershipId String             @map("owner_membership_id") @db.Uuid
  dueAt             DateTime           @map("due_at") @db.Timestamptz(6)
  status            EscalationStatus   @default(open)
  note              String             @default("") @db.VarChar(2000)
  resolvedAt        DateTime?          @map("resolved_at") @db.Timestamptz(6)
  version           Int                @default(1)
  createdById       String             @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  review       Review       @relation(fields: [reviewId], references: [id])
  owner        Membership   @relation("EscalationOwner", fields: [ownerMembershipId], references: [id])
  createdBy    User         @relation("EscalationCreatedBy", fields: [createdById], references: [id])

  @@unique([orgId, code])
  @@index([orgId, status, dueAt])
  @@map("escalations")
}
