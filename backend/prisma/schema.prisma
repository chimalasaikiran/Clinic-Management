// ClinicOS database schema (Neon PostgreSQL).
// Tables and columns use snake_case in the database and camelCase in TypeScript.
// Change this file, then create a migration with `npm run db:migrate:dev -- --name <change>`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless imports so the generated files compile with the rest of the CommonJS build.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ───────────────────────────────────────────────────────────────

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  // Always stored trimmed and lower-cased by the API, so the unique index is case-insensitive in practice.
  email             String     @unique @db.VarChar(254)
  fullName          String     @map("full_name") @db.VarChar(120)
  // Argon2id encoded hash (algorithm, parameters, salt and hash in one string). Never the password.
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  status            UserStatus @default(active)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  // Consecutive failed sign-ins; reset on success. Drives the temporary lock in lockedUntil.
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions              Session[]
  verificationCodes     VerificationCode[]
  memberships           Membership[]           @relation("MembershipUser")
  invitedMemberships    Membership[]           @relation("MembershipInvitedBy")
  createdOrganisations  Organisation[]
  createdRoles          Role[]                 @relation("RoleCreatedBy")
  updatedRoles          Role[]                 @relation("RoleUpdatedBy")
  sentInvitations       Invitation[]           @relation("InvitationInvitedBy")
  acceptedInvitations   Invitation[]           @relation("InvitationAcceptedBy")
  createdPatients       Patient[]              @relation("PatientCreatedBy")
  portalPatients        Patient[]              @relation("PatientPortalUser")
  bookedAppointments    Appointment[]          @relation("AppointmentBookedBy")
  appointmentEvents     AppointmentEvent[]
  createdStaff          StaffMember[]          @relation("StaffCreatedBy")
  recordedAttendance    AttendanceRecord[]     @relation("AttendanceRecordedBy")
  attendanceCorrections AttendanceCorrection[] @relation("AttendanceCorrectedBy")
  createdLeaves         StaffLeave[]           @relation("LeaveCreatedBy")
  cancelledLeaves       StaffLeave[]           @relation("LeaveCancelledBy")
  signedEncounters      Encounter[]            @relation("EncounterSignedBy")
  createdEncounters     Encounter[]            @relation("EncounterCreatedBy")
  recordedVitals        VitalSign[]            @relation("VitalsRecordedBy")
  recordedDiagnoses     Diagnosis[]            @relation("DiagnosisRecordedBy")
  recordedAllergies     Allergy[]              @relation("AllergyRecordedBy")
  acknowledgedAlerts    ClinicalAlert[]        @relation("AlertAcknowledgedBy")
  createdAlerts         ClinicalAlert[]        @relation("AlertCreatedBy")
  authoredNotes         ClinicalNote[]         @relation("NoteAuthor")
  authoredAddenda       NoteAddendum[]         @relation("AddendumAuthor")
  createdPrescriptions  Prescription[]         @relation("PrescriptionCreatedBy")
  prescriptionEvents    PrescriptionEvent[]    @relation("PrescriptionEventActor")
  createdOrders         DiagnosticOrder[]      @relation("OrderCreatedBy")
  orderEvents           OrderEvent[]           @relation("OrderEventActor")
  createdReferrals      Referral[]             @relation("ReferralCreatedBy")
  referralEvents        ReferralEvent[]        @relation("ReferralEventActor")
  createdCarePlans      CarePlan[]             @relation("CarePlanCreatedBy")
  carePlanReviews       CarePlanReview[]       @relation("CarePlanReviewAuthor")
  reportedIncidents     Incident[]             @relation("IncidentReporter")
  createdServices       BillingService[]       @relation("BillingServiceCreatedBy")
  billingSettings       BillingSettings[]      @relation("BillingSettingsUpdatedBy")
  financeEvents         FinanceEvent[]         @relation("FinanceEventActor")
  createdCharges        Charge[]               @relation("ChargeCreatedBy")
  createdInvoices       Invoice[]              @relation("InvoiceCreatedBy")
  recordedPayments      Payment[]              @relation("PaymentRecordedBy")
  createdAllocations    PaymentAllocation[]    @relation("AllocationCreatedBy")
  requestedRefunds      Refund[]               @relation("RefundRequestedBy")
  statementImports      StatementImport[]      @relation("StatementImportedBy")
  ownedReconExceptions  ReconException[]       @relation("ReconExceptionOwner")
  stockMovements        StockMovement[]        @relation("StockMovementActor")
  inventoryEvents       InventoryEvent[]       @relation("InventoryEventActor")
  stockRequests         StockRequest[]         @relation("StockRequestedBy")
  createdTransfers      StockTransfer[]        @relation("TransferCreatedBy")
  createdPurchaseOrders PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  goodsReceipts         GoodsReceipt[]         @relation("GoodsReceivedBy")
  recordedAdjustments   StockAdjustment[]      @relation("AdjustmentRecordedBy")
  decidedAdjustments    StockAdjustment[]      @relation("AdjustmentDecidedBy")
  dispenses             Dispense[]             @relation("DispensedBy")
  assignedCases         PharmacyCase[]         @relation("CaseAssignee")
  reportedCases         PharmacyCase[]         @relation("CaseReportedBy")

  payrollSettings         PayrollSettings[]   @relation("PayrollSettingsUpdatedBy")
  verifiedPayProfiles     PayProfile[]        @relation("PayProfileBankVerifiedBy")
  createdPayrollCycles    PayrollCycle[]      @relation("PayrollCycleCreatedBy")
  approvedPayrollCycles   PayrollCycle[]      @relation("PayrollCycleApprovedBy")
  processedPayrollCycles  PayrollCycle[]      @relation("PayrollCycleProcessedBy")
  recordedPayrollPayments PayrollEntry[]      @relation("PayrollEntryPaidBy")
  requestedPayAdjustments PayrollAdjustment[] @relation("PayAdjustmentRequestedBy")
  decidedPayAdjustments   PayrollAdjustment[] @relation("PayAdjustmentDecidedBy")
  createdAdvances         PayrollAdvance[]    @relation("AdvanceCreatedBy")
  approvedAdvances        PayrollAdvance[]    @relation("AdvanceApprovedBy")
  payrollEvents           PayrollEvent[]      @relation("PayrollEventActor")

  createdLeads   Lead[]         @relation("LeadCreatedBy")
  convertedLeads Lead[]         @relation("LeadConvertedBy")
  leadActivities LeadActivity[] @relation("LeadActivityActor")

  updatedChannels   MessagingChannel[] @relation("ChannelUpdatedBy")
  updatedTemplates  MessageTemplate[]  @relation("TemplateUpdatedBy")
  recordedConsents  ContactConsent[]   @relation("ConsentRecordedBy")
  sentMessages      Message[]          @relation("MessageSentBy")
  conversationNotes ConversationNote[] @relation("ConversationNoteAuthor")

  audiencesCreated    Audience[]          @relation("AudienceCreatedBy")
  audiencesUpdated    Audience[]          @relation("AudienceUpdatedBy")
  audienceVersions    AudienceVersion[]   @relation("AudienceVersionActor")
  campaignsCreated    Campaign[]          @relation("CampaignCreatedBy")
  campaignSpend       CampaignSpend[]     @relation("CampaignSpendRecordedBy")
  campaignEvents      CampaignEvent[]     @relation("CampaignEventActor")
  broadcastsCreated   CampaignBroadcast[] @relation("BroadcastCreatedBy")
  broadcastsCancelled CampaignBroadcast[] @relation("BroadcastCancelledBy")
  workflowsCreated    Workflow[]          @relation("WorkflowCreatedBy")
  workflowsUpdated    Workflow[]          @relation("WorkflowUpdatedBy")
  workflowsActivated  Workflow[]          @relation("WorkflowActivatedBy")

  contentTemplatesUpdated  ContentTemplate[] @relation("ContentTemplateUpdatedBy")
  contentCreated           ContentPost[]     @relation("ContentCreatedBy")
  contentSubmitted         ContentPost[]     @relation("ContentSubmittedBy")
  contentApproved          ContentPost[]     @relation("ContentApprovedBy")
  contentEvents            ContentEvent[]    @relation("ContentEventActor")
  branchProfilesUpdated    BranchProfile[]   @relation("BranchProfileUpdatedBy")
  reviewResponsesSubmitted ReviewResponse[]  @relation("ReviewResponseSubmittedBy")
  reviewResponsesApproved  ReviewResponse[]  @relation("ReviewResponseApprovedBy")
  reviewNotes              ReviewNote[]      @relation("ReviewNoteAuthor")
  escalationsCreated       Escalation[]      @relation("EscalationCreatedBy")

  @@map("users")
}

// One row per signed-in browser. The cookie holds a random token; only its keyed hash is stored here.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  // Absolute limit; the idle limit is checked against lastSeenAt.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip         String?   @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum CodePurpose {
  email_verification
  password_reset

  @@map("code_purpose")
}

model VerificationCode {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  purpose    CodePurpose
  codeHash   String      @map("code_hash") @db.Char(64)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(6)
  attempts   Int         @default(0)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@map("verification_codes")
}

// ─── Organisations ──────────────────────────────────────────────────────────

enum OrganisationStatus {
  onboarding
  active
  suspended

  @@map("organisation_status")
}

model Organisation {
  id           String             @id @default(uuid(7)) @db.Uuid
  displayName  String             @map("display_name") @db.VarChar(160)
  facilityType String             @map("facility_type") @db.VarChar(80)
  location     String             @db.VarChar(240)
  city         String             @db.VarChar(80)
  state        String             @db.VarChar(80)
  status       OrganisationStatus @default(onboarding)
  createdById  String             @map("created_by") @db.Uuid
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     User              @relation(fields: [createdById], references: [id])
  branches      Branch[]
  memberships   Membership[]
  roles         Role[]
  invitations   Invitation[]
  patients      Patient[]
  practitioners Practitioner[]
  appointments  Appointment[]
  counters      OrgCounter[]
  staff         StaffMember[]
  encounters    Encounter[]
  vitalSigns    VitalSign[]
  diagnoses     Diagnosis[]
  allergies     Allergy[]
  alerts        ClinicalAlert[]
  notes         ClinicalNote[]
  prescriptions Prescription[]
  orders        DiagnosticOrder[]
  referrals     Referral[]
  carePlans     CarePlan[]
  incidents     Incident[]

  billingServices  BillingService[]
  billingSettings  BillingSettings?
  financeEvents    FinanceEvent[]
  charges          Charge[]
  invoices         Invoice[]
  payments         Payment[]
  allocations      PaymentAllocation[]
  refunds          Refund[]
  statementImports StatementImport[]
  statementLines   StatementLine[]
  reconExceptions  ReconException[]

  stockItems       StockItem[]
  stockLocations   StockLocation[]
  suppliers        Supplier[]
  stockBatches     StockBatch[]
  stockMovements   StockMovement[]
  inventoryEvents  InventoryEvent[]
  stockRequests    StockRequest[]
  stockTransfers   StockTransfer[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  stockAdjustments StockAdjustment[]
  dispenses        Dispense[]
  pharmacyCases    PharmacyCase[]

  payrollSettings    PayrollSettings?
  payProfiles        PayProfile[]
  payrollCycles      PayrollCycle[]
  payrollAdjustments PayrollAdjustment[]
  payrollAdvances    PayrollAdvance[]
  payrollEvents      PayrollEvent[]

  leads          Lead[]
  leadActivities LeadActivity[]

  messagingChannels MessagingChannel[]
  messageTemplates  MessageTemplate[]
  contactConsents   ContactConsent[]
  conversations     Conversation[]
  messages          Message[]

  audiences    Audience[]
  campaigns    Campaign[]
  broadcasts   CampaignBroadcast[]
  workflows    Workflow[]
  workflowRuns WorkflowRun[]

  growthIntegrations GrowthIntegration[]
  mediaAssets        MediaAsset[]
  contentTemplates   ContentTemplate[]
  contentPosts       ContentPost[]
  branchProfiles     BranchProfile[]
  reviews            Review[]
  escalations        Escalation[]

  @@map("organisations")
}

enum BranchStatus {
  planned
  active
  paused
  inactive

  @@map("branch_status")
}

model Branch {
  id        String       @id @default(uuid(7)) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  code      String       @db.VarChar(20)
  name      String       @db.VarChar(240)
  city      String       @db.VarChar(80)
  state     String       @db.VarChar(80)
  status    BranchStatus @default(active)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation   Organisation               @relation(fields: [orgId], references: [id])
  roleBranches   RoleBranch[]
  patients       Patient[]
  availability   PractitionerAvailability[]
  appointments   Appointment[]
  staff          StaffBranch[]
  attendance     AttendanceRecord[]
  leaves         StaffLeave[]
  encounters     Encounter[]
  prescriptions  Prescription[]
  orders         DiagnosticOrder[]
  incidents      Incident[]
  servicePrices  BillingServicePrice[]
  charges        Charge[]
  invoices       Invoice[]
  payments       Payment[]
  stockLocations StockLocation[]
  payrollEntries PayrollEntry[]
  leads          Lead[]
  conversations  Conversation[]

  audiences Audience[]
  campaigns Campaign[]
  workflows Workflow[]

  contentPosts ContentPost[]
  profile      BranchProfile?
  reviews      Review[]

  @@unique([orgId, code])
  @@map("branches")
}

enum MembershipStatus {
  active
  suspended
  removed

  @@map("membership_status")
}

model Membership {
  id          String           @id @default(uuid(7)) @db.Uuid
  orgId       String           @map("org_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      MembershipStatus @default(active)
  invitedById String?          @map("invited_by") @db.Uuid
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation   Organisation     @relation(fields: [orgId], references: [id])
  user           User             @relation("MembershipUser", fields: [userId], references: [id])
  invitedBy      User?            @relation("MembershipInvitedBy", fields: [invitedById], references: [id])
  roles          MembershipRole[]
  practitioner   Practitioner?
  staff          StaffMember?
  ownedLeads     Lead[]           @relation("LeadOwner")
  leadActivities LeadActivity[]   @relation("LeadActivityOwner")
  conversations  Conversation[]   @relation("ConversationOwner")

  ownedCampaigns Campaign[] @relation("CampaignOwner")
  ownedWorkflows Workflow[] @relation("WorkflowOwner")

  ownedContent     ContentPost[] @relation("ContentOwner")
  ownedEscalations Escalation[]  @relation("EscalationOwner")

  @@unique([orgId, userId])
  @@index([userId, status])
  @@map("memberships")
}

// ─── Roles and permissions ──────────────────────────────────────────────────

enum RoleScope {
  org
  branch

  @@map("role_scope")
}

enum RoleStatus {
  draft
  active
  inactive

  @@map("role_status")
}

model Role {
  id          String     @id @default(uuid(7)) @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  name        String     @db.VarChar(80)
  // lower(trim(name)): keeps role names unique per organisation regardless of case.
  nameKey     String     @map("name_key") @db.VarChar(80)
  category    String     @db.VarChar(80)
  scope       RoleScope
  isSystem    Boolean    @default(false) @map("is_system")
  status      RoleStatus @default(active)
  description String     @default("") @db.VarChar(1000)
  createdById String?    @map("created_by") @db.Uuid
  updatedById String?    @map("updated_by") @db.Uuid
  version     Int        @default(1)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation     @relation(fields: [orgId], references: [id])
  createdBy    User?            @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?            @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  permissions  RolePermission[]
  branches     RoleBranch[]
  memberships  MembershipRole[]

  @@unique([orgId, nameKey])
  @@index([orgId, status])
  @@map("roles")
}

// Permission ids come from the catalogue in src/modules/permissions/permission-catalogue.ts.
model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String @db.VarChar(64)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model RoleBranch {
  roleId   String @map("role_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([roleId, branchId])
  @@index([branchId])
  @@map("role_branches")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model Invitation {
  id           String    @id @default(uuid(7)) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  email        String    @db.VarChar(254)
  roleIds      String[]  @map("role_ids") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  invitedById  String    @map("invited_by") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedById String?   @map("accepted_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])
  staff        StaffMember?

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, email])
  @@map("invitations")
}

// ─── Platform ───────────────────────────────────────────────────────────────

// Fixed-window counters shared by every API instance. Keys are keyed hashes (they would contain emails and IPs).
model RateLimit {
  key         String   @id @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hits        Int

  @@index([windowStart])
  @@map("rate_limits")
}

// Append-only record of security-relevant events.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  orgId       String?  @map("org_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  ip          String?  @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(300)
  traceId     String?  @map("trace_id") @db.VarChar(64)
  details     Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([orgId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

// ─── Patients ───────────────────────────────────────────────────────────────

enum PatientStatus {
  active
  inactive

  @@map("patient_status")
}

enum Gender {
  male
  female
  other

  @@map("gender")
}

// Organisation-level master record: one patient file shared by every branch.
model Patient {
  id                String        @id @default(uuid(7)) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  // Human-facing identifier (PT-000001), issued from the organisation counter and never reused.
  mrn               String        @db.VarChar(20)
  title             String        @db.VarChar(12)
  fullName          String        @map("full_name") @db.VarChar(120)
  alias             String?       @db.VarChar(120)
  aadhaarLast4      String?       @map("aadhaar_last4") @db.Char(4)
  abhaNumber        String?       @map("abha_number") @db.VarChar(20)
  // Ten-digit Indian mobile numbers, digits only.
  mobile            String        @db.VarChar(10)
  altMobile         String?       @map("alt_mobile") @db.VarChar(10)
  email             String?       @db.VarChar(254)
  addressLine       String?       @map("address_line") @db.VarChar(240)
  area              String?       @db.VarChar(160)
  city              String?       @db.VarChar(80)
  state             String?       @db.VarChar(80)
  pinCode           String        @map("pin_code") @db.Char(6)
  dateOfBirth       DateTime      @map("date_of_birth") @db.Date
  gender            Gender
  bloodGroup        String?       @map("blood_group") @db.VarChar(3)
  language          String?       @db.VarChar(40)
  emergencyName     String?       @map("emergency_name") @db.VarChar(120)
  emergencyRelation String?       @map("emergency_relation") @db.VarChar(40)
  emergencyPhone    String?       @map("emergency_phone") @db.VarChar(10)
  notifyWhatsapp    Boolean       @default(true) @map("notify_whatsapp")
  notifySms         Boolean       @default(true) @map("notify_sms")
  homeBranchId      String        @map("home_branch_id") @db.Uuid
  intakeUnit        String?       @map("intake_unit") @db.VarChar(80)
  status            PatientStatus @default(active)
  statusNote        String?       @map("status_note") @db.VarChar(160)
  // Reserved for a future patient portal: the login allowed to see this record. Unused until then.
  portalUserId      String?       @unique @map("portal_user_id") @db.Uuid
  createdById       String        @map("created_by") @db.Uuid
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation  Organisation      @relation(fields: [orgId], references: [id])
  homeBranch    Branch            @relation(fields: [homeBranchId], references: [id])
  portalUser    User?             @relation("PatientPortalUser", fields: [portalUserId], references: [id])
  createdBy     User              @relation("PatientCreatedBy", fields: [createdById], references: [id])
  appointments  Appointment[]
  encounters    Encounter[]
  vitalSigns    VitalSign[]
  diagnoses     Diagnosis[]
  allergies     Allergy[]
  alerts        ClinicalAlert[]
  notes         ClinicalNote[]
  prescriptions Prescription[]
  orders        DiagnosticOrder[]
  referrals     Referral[]
  carePlans     CarePlan[]
  incidents     Incident[]
  charges       Charge[]
  invoices      Invoice[]
  payments      Payment[]
  refunds       Refund[]
  leads         Lead[]
  conversations Conversation[]
  consents      ContactConsent[]

  broadcastRecipients BroadcastRecipient[]
  workflowRuns        WorkflowRun[]

  @@unique([orgId, mrn])
  @@index([orgId, mobile])
  @@index([orgId, status, createdAt])
  @@index([orgId, fullName])
  @@map("patients")
}

// ─── Scheduling ─────────────────────────────────────────────────────────────

enum PractitionerStatus {
  active
  inactive

  @@map("practitioner_status")
}

// A member of staff who sees patients (doctor, therapist). Appointments are booked against this profile.
model Practitioner {
  id           String             @id @default(uuid(7)) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  membershipId String             @unique @map("membership_id") @db.Uuid
  displayName  String             @map("display_name") @db.VarChar(120)
  credentials  String?            @db.VarChar(120)
  specialty    String             @db.VarChar(120)
  department   String             @db.VarChar(120)
  room         String?            @db.VarChar(60)
  // Length of one appointment slot; every booking with this practitioner takes one slot.
  slotMinutes  Int                @map("slot_minutes")
  status       PractitionerStatus @default(active)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation               @relation(fields: [orgId], references: [id])
  membership   Membership                 @relation(fields: [membershipId], references: [id])
  availability PractitionerAvailability[]
  appointments Appointment[]
  encounters   Encounter[]
  referrals    Referral[]
  carePlans    CarePlan[]

  @@index([orgId, status])
  @@map("practitioners")
}

// Weekly recurring consulting window at one branch, in the clinic's local time.
model PractitionerAvailability {
  id             String @id @default(uuid(7)) @db.Uuid
  practitionerId String @map("practitioner_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  // 0 = Sunday … 6 = Saturday.
  weekday        Int    @db.SmallInt
  // Minutes after local midnight, e.g. 540 = 09:00.
  startMinute    Int    @map("start_minute") @db.SmallInt
  endMinute      Int    @map("end_minute") @db.SmallInt

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])

  @@index([practitionerId, weekday])
  @@map("practitioner_availability")
}

enum AppointmentStatus {
  pending
  confirmed
  arrived
  in_progress
  completed
  cancelled
  no_show

  @@map("appointment_status")
}

enum AppointmentType {
  consultation
  follow_up
  procedure
  diagnostic_review

  @@map("appointment_type")
}

enum BookingChannel {
  reception
  phone
  portal
  referral
  walk_in

  @@map("booking_channel")
}

model Appointment {
  id             String            @id @default(uuid(7)) @db.Uuid
  orgId          String            @map("org_id") @db.Uuid
  // Human-facing identifier (APT-000001) from the organisation counter.
  reference      String            @db.VarChar(20)
  patientId      String            @map("patient_id") @db.Uuid
  practitionerId String            @map("practitioner_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  startsAt       DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime          @map("ends_at") @db.Timestamptz(6)
  type           AppointmentType
  status         AppointmentStatus
  channel        BookingChannel
  // A walk-in waiting for the next free chamber rather than holding a slot of their own.
  waitingQueue   Boolean           @default(false) @map("waiting_queue")
  reason         String            @db.VarChar(500)
  internalNote   String?           @map("internal_note") @db.VarChar(1000)
  notifyWhatsapp Boolean           @default(true) @map("notify_whatsapp")
  notifySms      Boolean           @default(true) @map("notify_sms")
  queueToken     String?           @map("queue_token") @db.VarChar(10)
  arrivedAt      DateTime?         @map("arrived_at") @db.Timestamptz(6)
  closedReason   String?           @map("closed_reason") @db.VarChar(120)
  bookedById     String            @map("booked_by") @db.Uuid
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [orgId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  practitioner Practitioner       @relation(fields: [practitionerId], references: [id])
  branch       Branch             @relation(fields: [branchId], references: [id])
  bookedBy     User               @relation("AppointmentBookedBy", fields: [bookedById], references: [id])
  events       AppointmentEvent[]
  encounter    Encounter?

  workflowRuns WorkflowRun[]

  @@unique([orgId, reference])
  @@index([orgId, practitionerId, startsAt])
  @@index([orgId, patientId, startsAt])
  @@index([orgId, branchId, startsAt])
  @@map("appointments")
}

// Append-only history of everything that happened to an appointment.
model AppointmentEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  action        String             @db.VarChar(40)
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  fromStartsAt  DateTime?          @map("from_starts_at") @db.Timestamptz(6)
  toStartsAt    DateTime?          @map("to_starts_at") @db.Timestamptz(6)
  reason        String?            @db.VarChar(120)
  note          String?            @db.VarChar(1000)
  actorUserId   String             @map("actor_user_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User        @relation(fields: [actorUserId], references: [id])

  @@index([appointmentId, createdAt])
  @@map("appointment_events")
}

// Per-organisation counters for human-facing numbers (MRNs, appointment references, daily queue tokens).
model OrgCounter {
  orgId String @map("org_id") @db.Uuid
  name  String @db.VarChar(80)
  value Int

  organisation Organisation @relation(fields: [orgId], references: [id])

  @@id([orgId, name])
  @@map("org_counters")
}

// ─── Staff ──────────────────────────────────────────────────────────────────

enum StaffType {
  doctor
  staff

  @@map("staff_type")
}

enum StaffStatus {
  active
  draft
  inactive

  @@map("staff_status")
}

enum Engagement {
  full_time
  visiting
  honorary

  @@map("engagement")
}

// A person who works for the organisation (doctor, nurse, pharmacist, receptionist …). A ClinicOS login is
// optional: membershipId links the record to an account once the person has one.
model StaffMember {
  id             String      @id @default(uuid(7)) @db.Uuid
  orgId          String      @map("org_id") @db.Uuid
  // Human-facing identifier (STF-001) from the organisation counter.
  staffCode      String      @map("staff_code") @db.VarChar(20)
  type           StaffType
  fullName       String      @map("full_name") @db.VarChar(120)
  email          String?     @db.VarChar(254)
  mobile         String?     @db.VarChar(10)
  department     String      @db.VarChar(120)
  designation    String      @db.VarChar(160)
  council        String?     @db.VarChar(120)
  councilNumber  String?     @map("council_number") @db.VarChar(60)
  qualifications String[]    @db.VarChar(60)
  engagement     Engagement  @default(full_time)
  status         StaffStatus @default(active)
  membershipId   String?     @unique @map("membership_id") @db.Uuid
  // The pending invitation that will link this record to an account when accepted.
  invitationId   String?     @unique @map("invitation_id") @db.Uuid
  createdById    String      @map("created_by") @db.Uuid
  version        Int         @default(1)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [orgId], references: [id])
  membership   Membership?        @relation(fields: [membershipId], references: [id])
  invitation   Invitation?        @relation(fields: [invitationId], references: [id])
  createdBy    User               @relation("StaffCreatedBy", fields: [createdById], references: [id])
  branches     StaffBranch[]
  attendance   AttendanceRecord[]
  leaves       StaffLeave[]

  payProfile         PayProfile?
  payrollEntries     PayrollEntry[]
  payrollAdjustments PayrollAdjustment[]
  payrollAdvances    PayrollAdvance[]

  @@unique([orgId, staffCode])
  @@index([orgId, status])
  @@index([orgId, fullName])
  @@map("staff_members")
}

model StaffBranch {
  staffId   String   @map("staff_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  staff  StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch      @relation(fields: [branchId], references: [id])

  @@id([staffId, branchId])
  @@index([branchId])
  @@map("staff_branches")
}

enum AttendanceStatus {
  present
  late
  absent
  leave
  unavailable

  @@map("attendance_status")
}

// What actually happened on a day at a branch, recorded by an authorised person. One record per person, branch
// and date; corrections keep the previous values in attendance_corrections.
model AttendanceRecord {
  id            String           @id @default(uuid(7)) @db.Uuid
  staffId       String           @map("staff_id") @db.Uuid
  branchId      String           @map("branch_id") @db.Uuid
  date          DateTime         @db.Date
  status        AttendanceStatus
  // Arrival time on the local clock, minutes after midnight; only for present and late.
  arrivalMinute Int?             @map("arrival_minute") @db.SmallInt
  note          String?          @db.VarChar(500)
  recordedById  String           @map("recorded_by") @db.Uuid
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  staff       StaffMember            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch      Branch                 @relation(fields: [branchId], references: [id])
  recordedBy  User                   @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  corrections AttendanceCorrection[]

  @@unique([staffId, branchId, date])
  @@index([staffId, date])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id            String           @id @default(uuid(7)) @db.Uuid
  attendanceId  String           @map("attendance_id") @db.Uuid
  fromStatus    AttendanceStatus @map("from_status")
  toStatus      AttendanceStatus @map("to_status")
  fromMinute    Int?             @map("from_minute") @db.SmallInt
  toMinute      Int?             @map("to_minute") @db.SmallInt
  reason        String           @db.VarChar(500)
  correctedById String           @map("corrected_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  attendance  AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  correctedBy User             @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id])

  @@index([attendanceId, createdAt])
  @@map("attendance_corrections")
}

enum LeaveKind {
  leave
  block
  relief

  @@map("leave_kind")
}

enum LeaveStatus {
  scheduled
  cancelled

  @@map("leave_status")
}

// Planned leave or a temporary block. While scheduled it removes the person's appointment slots for those
// dates (and times, for a block), at one branch or all of them.
model StaffLeave {
  id            String      @id @default(uuid(7)) @db.Uuid
  staffId       String      @map("staff_id") @db.Uuid
  kind          LeaveKind
  title         String      @db.VarChar(120)
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  // Both null for whole days; otherwise the blocked window on each of the dates.
  startMinute   Int?        @map("start_minute") @db.SmallInt
  endMinute     Int?        @map("end_minute") @db.SmallInt
  // Null means every branch the person works at.
  branchId      String?     @map("branch_id") @db.Uuid
  reason        String      @db.VarChar(500)
  status        LeaveStatus @default(scheduled)
  createdById   String      @map("created_by") @db.Uuid
  cancelledById String?     @map("cancelled_by") @db.Uuid
  cancelledAt   DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id])
  createdBy   User        @relation("LeaveCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?       @relation("LeaveCancelledBy", fields: [cancelledById], references: [id])

  @@index([staffId, startDate])
  @@map("staff_leaves")
}

// ─── Clinical ───────────────────────────────────────────────────────────────

enum EncounterStatus {
  in_progress
  signed

  @@map("encounter_status")
}

// One consultation. Editable while in progress; signing locks it (corrections become note addenda).
model Encounter {
  id             String          @id @default(uuid(7)) @db.Uuid
  orgId          String          @map("org_id") @db.Uuid
  reference      String          @db.VarChar(20)
  patientId      String          @map("patient_id") @db.Uuid
  appointmentId  String?         @unique @map("appointment_id") @db.Uuid
  practitionerId String?         @map("practitioner_id") @db.Uuid
  branchId       String          @map("branch_id") @db.Uuid
  type           String          @db.VarChar(120)
  reason         String          @db.VarChar(500)
  chiefComplaint String          @default("") @map("chief_complaint") @db.VarChar(2000)
  subjective     String          @default("") @db.VarChar(4000)
  objective      String          @default("") @db.VarChar(4000)
  assessment     String          @default("") @db.VarChar(4000)
  plan           String          @default("") @db.VarChar(4000)
  status         EncounterStatus @default(in_progress)
  startedAt      DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  signedAt       DateTime?       @map("signed_at") @db.Timestamptz(6)
  signedById     String?         @map("signed_by") @db.Uuid
  createdById    String          @map("created_by") @db.Uuid
  version        Int             @default(1)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation  Organisation      @relation(fields: [orgId], references: [id])
  patient       Patient           @relation(fields: [patientId], references: [id])
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id])
  practitioner  Practitioner?     @relation(fields: [practitionerId], references: [id])
  branch        Branch            @relation(fields: [branchId], references: [id])
  signedBy      User?             @relation("EncounterSignedBy", fields: [signedById], references: [id])
  createdBy     User              @relation("EncounterCreatedBy", fields: [createdById], references: [id])
  vitals        VitalSign[]
  diagnoses     Diagnosis[]
  notes         ClinicalNote[]
  prescriptions Prescription[]
  orders        DiagnosticOrder[]
  referrals     Referral[]
  charges       Charge[]
  invoices      Invoice[]

  @@unique([orgId, reference])
  @@index([orgId, patientId, startedAt])
  @@index([orgId, status])
  @@map("encounters")
}

model VitalSign {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  encounterId  String?  @map("encounter_id") @db.Uuid
  systolic     Int      @db.SmallInt
  diastolic    Int      @db.SmallInt
  pulse        Int      @db.SmallInt
  respiration  Int      @db.SmallInt
  temperatureF Float    @map("temperature_f")
  spo2         Int      @db.SmallInt
  weightKg     Float    @map("weight_kg")
  heightCm     Float    @map("height_cm")
  bloodSugar   Int?     @map("blood_sugar") @db.SmallInt
  painScore    Int?     @map("pain_score") @db.SmallInt
  site         String?  @db.VarChar(120)
  posture      String?  @db.VarChar(120)
  device       String?  @db.VarChar(120)
  recordedById String   @map("recorded_by") @db.Uuid
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  recordedBy   User         @relation("VitalsRecordedBy", fields: [recordedById], references: [id])

  @@index([orgId, patientId, recordedAt])
  @@map("vital_signs")
}

enum DiagnosisStatus {
  active
  resolved

  @@map("diagnosis_status")
}

model Diagnosis {
  id           String          @id @default(uuid(7)) @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  patientId    String          @map("patient_id") @db.Uuid
  encounterId  String?         @map("encounter_id") @db.Uuid
  icd          String          @db.VarChar(20)
  snomed       String?         @db.VarChar(20)
  name         String          @db.VarChar(240)
  designation  String          @default("Primary") @db.VarChar(20)
  verification String          @default("Confirmed") @db.VarChar(20)
  severity     String?         @db.VarChar(60)
  description  String          @db.VarChar(2000)
  status       DiagnosisStatus @default(active)
  recordedById String          @map("recorded_by") @db.Uuid
  recordedAt   DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  resolvedAt   DateTime?       @map("resolved_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  recordedBy   User         @relation("DiagnosisRecordedBy", fields: [recordedById], references: [id])

  @@index([orgId, patientId, status])
  @@map("diagnoses")
}

enum AllergySeverity {
  mild
  moderate
  severe

  @@map("allergy_severity")
}

model Allergy {
  id           String          @id @default(uuid(7)) @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  patientId    String          @map("patient_id") @db.Uuid
  substance    String          @db.VarChar(160)
  // Medicine class used for prescription cross-checks (for example "penicillin", "nsaid").
  drugClass    String?         @map("drug_class") @db.VarChar(60)
  classLabel   String?         @map("class_label") @db.VarChar(120)
  severity     AllergySeverity
  reaction     String          @db.VarChar(500)
  verification String?         @db.VarChar(60)
  active       Boolean         @default(true)
  recordedById String          @map("recorded_by") @db.Uuid
  recordedAt   DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [orgId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  recordedBy   User         @relation("AllergyRecordedBy", fields: [recordedById], references: [id])

  @@index([orgId, patientId])
  @@map("allergies")
}

enum AlertSeverity {
  critical
  high
  moderate
  low

  @@map("alert_severity")
}

enum AlertStatus {
  active
  acknowledged
  resolved

  @@map("alert_status")
}

// A safety flag on the patient chart. Acknowledging needs a disposition and a justification.
model ClinicalAlert {
  id               String        @id @default(uuid(7)) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  patientId        String        @map("patient_id") @db.Uuid
  kind             String        @db.VarChar(80)
  title            String        @db.VarChar(240)
  severity         AlertSeverity
  status           AlertStatus   @default(active)
  detail           String        @db.VarChar(2000)
  statement        String?       @db.VarChar(2000)
  allergyId        String?       @unique @map("allergy_id") @db.Uuid
  // Raised by an abnormal or critical result; reviewing the result resolves it.
  orderId          String?       @map("order_id") @db.Uuid
  disposition      String?       @db.VarChar(60)
  justification    String?       @db.VarChar(2000)
  acknowledgedById String?       @map("acknowledged_by") @db.Uuid
  acknowledgedAt   DateTime?     @map("acknowledged_at") @db.Timestamptz(6)
  createdById      String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation   Organisation     @relation(fields: [orgId], references: [id])
  patient        Patient          @relation(fields: [patientId], references: [id])
  order          DiagnosticOrder? @relation(fields: [orderId], references: [id])
  acknowledgedBy User?            @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  createdBy      User?            @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([orgId, patientId, status])
  @@index([orgId, status, severity])
  @@index([orderId])
  @@map("clinical_alerts")
}

// A signed clinical note. Never edited after signing; later additions are addenda.
model ClinicalNote {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  encounterId String?  @map("encounter_id") @db.Uuid
  title       String   @db.VarChar(240)
  department  String?  @db.VarChar(120)
  // [{ heading, body }]
  sections    Json
  authorId    String   @map("author_id") @db.Uuid
  signedAt    DateTime @default(now()) @map("signed_at") @db.Timestamptz(6)

  organisation Organisation   @relation(fields: [orgId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id])
  encounter    Encounter?     @relation(fields: [encounterId], references: [id])
  author       User           @relation("NoteAuthor", fields: [authorId], references: [id])
  addenda      NoteAddendum[]

  @@index([orgId, patientId, signedAt])
  @@map("clinical_notes")
}

model NoteAddendum {
  id        String   @id @default(uuid(7)) @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  text      String   @db.VarChar(4000)
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  note   ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User         @relation("AddendumAuthor", fields: [authorId], references: [id])

  @@index([noteId, createdAt])
  @@map("note_addenda")
}

// ─── Prescriptions, diagnostic orders, referrals, care plans, incidents ─────

enum PrescriptionStatus {
  active
  completed
  discontinued

  @@map("prescription_status")
}

// A signed medication order. Its items never change; a correction discontinues it and a new one is written.
model Prescription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  orgId                  String             @map("org_id") @db.Uuid
  reference              String             @db.VarChar(20)
  patientId              String             @map("patient_id") @db.Uuid
  encounterId            String?            @map("encounter_id") @db.Uuid
  branchId               String             @map("branch_id") @db.Uuid
  // Snapshots taken at signing, so the record keeps showing who prescribed and under which registration.
  prescriberName         String             @map("prescriber_name") @db.VarChar(120)
  registration           String?            @db.VarChar(80)
  department             String?            @db.VarChar(120)
  indication             String             @db.VarChar(500)
  precautionAcknowledged Boolean            @default(false) @map("precaution_acknowledged")
  status                 PrescriptionStatus @default(active)
  // SHA-256 of the signed content (patient, prescriber, time and items), so later tampering is detectable.
  contentHash            String             @map("content_hash") @db.Char(64)
  createdById            String             @map("created_by") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  version                Int                @default(1)

  organisation Organisation        @relation(fields: [orgId], references: [id])
  patient      Patient             @relation(fields: [patientId], references: [id])
  encounter    Encounter?          @relation(fields: [encounterId], references: [id])
  branch       Branch              @relation(fields: [branchId], references: [id])
