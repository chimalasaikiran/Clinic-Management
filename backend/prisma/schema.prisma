  @@index([orgId, patientId, createdAt])
  @@index([orgId, status])
  @@map("diagnostic_orders")
}

model DiagnosticOrderItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  position    Int     @db.SmallInt
  code        String  @db.VarChar(40)
  name        String  @db.VarChar(240)
  category    String  @db.VarChar(60)
  loinc       String? @db.VarChar(20)
  destination String  @db.VarChar(240)
  priority    String  @db.VarChar(60)

  order DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, position])
  @@map("diagnostic_order_items")
}

model OrderEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  action    String   @db.VarChar(40)
  note      String   @default("") @db.VarChar(2000)
  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
