  @@map("result_flag")
}

// A laboratory or imaging order: ordered, specimen collected (lab), result recorded, reviewed by a clinician.
model DiagnosticOrder {
  id            String      @id @default(uuid(7)) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  reference     String      @db.VarChar(20)
  patientId     String      @map("patient_id") @db.Uuid
  encounterId   String?     @map("encounter_id") @db.Uuid
  branchId      String      @map("branch_id") @db.Uuid
  orderingName  String      @map("ordering_name") @db.VarChar(160)
  kind          OrderKind
  category      String      @db.VarChar(120)
  title         String      @db.VarChar(1000)
  indication    String      @db.VarChar(2000)
  performing    String      @db.VarChar(240)
  urgent        Boolean     @default(false)
  status        OrderStatus @default(ordered)
  accession     String?     @db.VarChar(40)
  specimenNote  String?     @map("specimen_note") @db.VarChar(1000)
