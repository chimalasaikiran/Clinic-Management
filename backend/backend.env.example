# ClinicOS backend configuration.
# Copy this file to backend/backend.env and fill in real values. backend.env is git-ignored: never commit it,
# never paste its values into frontend code or VITE_ variables. In production, set the same variables in the
# hosting platform's secret manager instead of a file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Neon console > your project > Dashboard > Connect.
# DATABASE_URL: the POOLED connection string ("Connection pooling" switched ON; host contains "-pooler").
#               Used by the running API.
# DIRECT_URL:   the DIRECT connection string ("Connection pooling" switched OFF). Used only by Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Connections per API instance (Neon's pooler multiplexes them).
DATABASE_POOL_MAX=10
# Longest a transaction may run (ms). Raise it when the database region is far from the API (e.g. 30000).
# DATABASE_TX_TIMEOUT_MS=10000
# Only needed if `npm run db:migrate:dev` cannot create its temporary shadow database (see README).
# SHADOW_DATABASE_URL=

# Integration tests only: a SEPARATE Neon branch (for example "test"). The tests delete all data in it.
# TEST_DATABASE_URL=
# TEST_DIRECT_URL=

# ── Web app ───────────────────────────────────────────────────────────────────
# Origin(s) of the admin panel allowed to call the API (comma-separated, no trailing slash),
# and the base URL used in links inside emails.
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# ── Secrets ───────────────────────────────────────────────────────────────────
# At least 32 random characters. Hashes session tokens, verification codes, invitation tokens and rate-limit keys.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out and invalidates codes and invitations already sent.
TOKEN_PEPPER=

# ── Sessions ──────────────────────────────────────────────────────────────────
# Signed-in sessions end after this long without activity, and after the absolute maximum regardless.
SESSION_IDLE_MINUTES=30
SESSION_MAX_AGE_HOURS=12
# Session cookie: Secure must be true in production (HTTPS). SameSite "lax" works when the admin panel and API
# share a site (app.example.com + api.example.com, or localhost). Use "none" only for different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Email ─────────────────────────────────────────────────────────────────────
# Email delivery. Use ONE of the options below; leave both empty locally to print emails (with codes) to the
# backend console. Production requires one of them.
#
# Option A: EmailJS (https://www.emailjs.com). Fill in all four. The template must send To {{to_email}},
# Subject {{subject}} and body {{message}}, and "Use Private Key" must be on in EmailJS Account > Security
# (also allow API calls from non-browser applications). See README "Email delivery".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
#
# Option B: SMTP. Example (Amazon SES): smtps://SMTP_USERNAME:SMTP_PASSWORD@email-smtp.ap-south-1.amazonaws.com:465
SMTP_URL=
MAIL_FROM=ClinicOS <no-reply@your-domain.com>

# ── Network ───────────────────────────────────────────────────────────────────
# Number of proxies in front of the API (1 behind a load balancer) so rate limits see the real client IP.
# Patient app sign-in codes by SMS (MSG91 Flow; the DLT template's one variable, var1, is the code).
# Leave both empty in development to print codes in the API console. Without them production patient sign-in is off.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# PATIENT_SESSION_IDLE_DAYS=30
# PATIENT_SESSION_MAX_DAYS=90

TRUST_PROXY=0

# ── Scheduling ────────────────────────────────────────────────────────────────
# IANA time zone of the clinics. Appointment dates, slots and daily queue tokens use it.
CLINIC_TIMEZONE=Asia/Kolkata

# ── Messaging (Growth) ────────────────────────────────────────────────────────
# Encrypts each organisation's WhatsApp, SMS and email credentials. Generate once and keep it safe (losing it means
# reconnecting every channel):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGING_SECRET_KEY=
# Sends queued messages, starts due broadcasts and runs workflows from this API process. Leave true unless another
# process runs the workers.
MESSAGING_WORKER=true
# The public https address of this API, shown on the Channels screen as the webhook URL to give Meta and MSG91.
# In development use any public https tunnel.
PUBLIC_API_URL=
# Optional: Neon's direct (non-pooled) connection string, so live updates (message inbox, bookings and
# notifications) reach every API instance.
# With one instance it can stay empty.
REALTIME_DATABASE_URL=
